# Astro 配置
# 是否使用基础路径前缀 (true/false)
PUBLIC_USE_BASE_PATH=true

# 基础路径 (不包含前导斜杠和尾部斜杠)
PUBLIC_BASE_PATH=xpx

# 站点 URL (用于生成站点地图和绝对 URL)
SITE_URL=https://xiepixie.github.io

# 部署配置
# 部署目标 (github, vercel, netlify)
DEPLOY_TARGET=github

# GitHub Pages 配置
# 仓库名称 (用于 GitHub Pages 部署)
GITHUB_REPO=xpx_blog

# 分析和跟踪
# 是否启用分析 (true/false)
ENABLE_ANALYTICS=false

# Giscus 评论系统配置
GISCUS_REPO=username/repo
GISCUS_REPO_ID=your-repo-id
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=your-category-id

# 开发配置
# 是否启用调试模式 (true/false)
DEBUG=false
