{
  "name": "tender-telescope",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "predev": "node copy-pagefind.js || true",
    "build": "astro build && pagefind --site dist --exclude-selectors \"header,footer,nav,.toc,.table-of-contents,.pagination,.comments,.article-feedback,.related-posts,aside,script,style,noscript,form\" --root-selector \"[data-pagefind-body]\" && node copy-pagefind.js",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "copy-pagefind": "node copy-pagefind.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.1",
    "@astrojs/mdx": "^4.2.5",
    "@astrojs/preact": "^4.0.10",
    "@astrojs/react": "^4.2.6",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.1",
    "@astrojs/solid-js": "^5.0.9",
    "@catppuccin/vscode": "^3.17.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdx-js/esbuild": "^3.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "@typescript-eslint/parser": "^8.31.1",
    "astro": "^5.7.9",
    "cally": "^0.8.0",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "daisyui": "^5.0.30",
    "docusaurus": "^1.14.7",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "eslint-plugin-astro": "^1.3.1",
    "framer-motion": "^12.9.2",
    "giscus": "^1.6.0",
    "immer": "^10.1.1",
    "loader-utils": "^3.3.1",
    "lucide-react": "^0.503.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.1",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-shiki": "^0.0.9",
    "rehype-slug": "^6.0.0",
    "rehype-toc": "^3.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver-regex": "^4.0.5",
    "sharp": "^0.34.1",
    "shell-quote": "^1.8.2",
    "tailwindcss": "^4.1.4",
    "unist-util-visit": "^5.0.0",
    "v": "^0.3.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "pagefind": "^1.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx,astro}": [
      "prettier --write"
    ]
  }
}
