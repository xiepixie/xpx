---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/comments/Giscus.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleFeedback from '../components/ArticleFeedback.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getPath } from '../lib/path';

interface Props {
	title: string;
	description?: string;
	publish_date: Date | string;
	draft?: boolean;
	update_date?: Date | string;
	tags?: string[];
	seo_image?: string;
	enableComments?: boolean;
	children?: unknown;
	author?: string;
	readingTime?: string;
	headings?: {
		depth: number;
		slug: string;
		text: string;
	}[];
}

const {
	title,
	description,
	publish_date,
	update_date,
	seo_image,
	tags = [],
	author,
	readingTime,
	enableComments = true,
	headings = []
} = Astro.props;

// 格式化日期
const formatDate = (date: Date | string | undefined) => {
  if (!date) return '';

  // 如果是字符串，转换为Date对象
  const dateObj = typeof date === 'string' ? new Date(date) : date;

  // 检查日期是否有效
  if (Number.isNaN(dateObj.getTime())) {
    return typeof date === 'string' ? date : '';
  }

  return dateObj.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// 获取ISO格式的日期字符串
const getISODate = (date: Date | string | undefined) => {
  if (!date) return '';

  // 如果是字符串，转换为Date对象
  const dateObj = typeof date === 'string' ? new Date(date) : date;

  // 检查日期是否有效
  if (Number.isNaN(dateObj.getTime())) {
    return '';
  }

  return dateObj.toISOString();
};

const formattedpublish_date = formatDate(publish_date);
const formattedupdate_date = formatDate(update_date);
---

<BaseLayout
	title={title}
	description={description}
	image={seo_image}
	type="article"
	publishDate={publish_date}
	updateDate={update_date}
	author={author}
	tags={tags}>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.15.6/dist/katex.min.css"
		integrity="sha384-ljao5I1l+8KYFXG7R1MEUaxJpAni7uqSgAWn0FFfj4K5l01xjfb'k3/B5pEkXo9h" crossorigin="anonymous" slot="head" />


	<script src={getPath("scripts/reading-progress.js")} is:inline></script>

		<div class="flex flex-col lg:flex-row max-w-screen-xl mx-auto px-4 sm:px-6 gap-8">
	<!-- 主内容区域 - 居中显示 -->
	<article class="prose lg:prose-xl dark:prose-invert flex-1 max-w-3xl mx-auto pt-8 pb-16 bg-base-100 rounded-xl shadow-md px-4 md:px-8" data-pagefind-body>
		{seo_image && (
			<div class="mb-6">
				<ResponsiveImage
					src={seo_image}
					alt={title}
					class="rounded-lg w-full"
					aspectRatio="16/9"
					loading="eager"
					sizes="(max-width: 768px) 100vw, (max-width: 1280px) 75vw, 960px"
				/>
			</div>
		)}

		<!-- 文章标题和元数据 -->
		<header class="mb-8">
			<h1 class="font-bold text-3xl md:text-4xl mb-4">{title}</h1>
			<div class="flex flex-wrap items-center text-base-content/70 text-sm gap-x-4 gap-y-2 border-b border-base-200 pb-4">
				{author && (
					<span class="flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
						{author}
					</span>
				)}
				<span class="flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
					<time datetime={getISODate(publish_date)}>{formattedpublish_date}</time>
				</span>
				{readingTime && (
					<span class="flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
						{readingTime}
					</span>
				)}
				{update_date && (
					<span class="flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
							<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
						</svg>
						更新于 <time datetime={getISODate(update_date)}>{formattedupdate_date}</time>
					</span>
				)}
			</div>
		</header>

		<!-- 移动端标签显示 -->
		{tags.length > 0 && (
			<div class="lg:hidden mb-6 flex flex-wrap gap-2 justify-center">
				{tags.map(tag => (
					<a href={getPath(`blog/tag/${tag}`)} class="badge badge-primary badge-lg">
						{tag}
					</a>
				))}
			</div>
		)}

		<!-- 文章内容 -->
		<div class="content">
			<slot />
		</div>

		<!-- 文章评分和反馈 -->
		<ArticleFeedback articleId={Astro.url.pathname.split('/').pop() || ''} />

		<!-- 相关文章 -->
		<RelatedPosts currentPostId={Astro.url.pathname.split('/').pop() || ''} tags={tags} maxPosts={3} />
	</article>

	<!-- 侧边栏 - 标签和目录导航 (右侧) -->
	<aside class="hidden lg:block w-64 pt-8 sticky top-24 self-start space-y-6 shrink-0">
		{tags.length > 0 && (
			<div class="card bg-base-100 shadow-sm border border-base-300 p-5 rounded-xl">
				<h2 class="text-lg font-bold mb-4 flex items-center text-primary">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
						<line x1="7" y1="7" x2="7.01" y2="7"></line>
					</svg>
					标签
				</h2>
				<div class="flex flex-wrap gap-2">
					{tags.map(tag => (
						<a href={getPath(`blog/tag/${tag}`)} class="badge badge-primary badge-lg">
							{tag}
						</a>
					))}
				</div>
			</div>
		)}
		<TableOfContents headings={headings} />
	</aside>
</div>

<!-- 返回顶部按钮 -->
<button id="back-to-top" class="fixed bottom-20 right-4 lg:right-6 z-30 bg-primary text-primary-content w-12 h-12 rounded-full flex items-center justify-center shadow-lg opacity-0 invisible transition-all duration-300">
	<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="18 15 12 9 6 15"></polyline>
	</svg>
</button>

<script is:inline>
	// 返回顶部按钮功能
	document.addEventListener('astro:page-load', () => {
		const backToTopButton = document.getElementById('back-to-top');

		if (backToTopButton) {
			// 初始化按钮状态
			if (window.scrollY > 300) {
				backToTopButton.classList.remove('opacity-0', 'invisible');
				backToTopButton.classList.add('opacity-100', 'visible');
			}

			// 监听滚动事件
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					backToTopButton.classList.remove('opacity-0', 'invisible');
					backToTopButton.classList.add('opacity-100', 'visible');
				} else {
					backToTopButton.classList.add('opacity-0', 'invisible');
					backToTopButton.classList.remove('opacity-100', 'visible');
				}
			});

			// 点击返回顶部
			backToTopButton.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});

			// 确保在移动设备上可见
			if (window.innerWidth < 768) {
				backToTopButton.style.bottom = '5rem';
				backToTopButton.style.right = '1rem';
				backToTopButton.style.zIndex = '50';
			}
		}
	});
</script>

	{enableComments && (
		<Giscus
			mapping="pathname"
			term=""
			reactionsEnabled={true}
			emitMetadata={false}
			inputPosition="top"
			theme="preferred_color_scheme"
			lang="zh-CN"
			loading="lazy"
			showTitle={true}
			title="评论"
		/>
	)}
</BaseLayout>

