---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/comments/Giscus.astro';

interface Props {
	title: string;
	description?: string;
	publish_date: Date;
	draft: boolean;
	update_date?: Date;
	tags?: string[];
	seo_image?: string;
	enableComments?: boolean;
	children?: any;
	author?: string;
	readingTime?: string;
}

const { 
	title, 
	description, 
	publish_date, 
	update_date, 
	seo_image, 
	tags = [], 
	author, 
	readingTime, 
	enableComments = true 
} = Astro.props;

// 格式化日期
const formattedpublish_date = publish_date.toLocaleDateString('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const formattedupdate_date = update_date?.toLocaleDateString('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.15.6/dist/katex.min.css"
		integrity="sha384-ljao5I1l+8KYFXG7R1MEUaxJpAni7uqSgAWn0FFfj4K5l01xjfb'k3/B5pEkXo9h" crossorigin="anonymous" slot="head" />

	<article class="prose lg:prose-xl dark:prose-invert mx-auto max-w-4xl pt-10 pb-20">
		{seo_image && (
			<div class="mb-8 overflow-hidden rounded-lg">
				<img 
					src={seo_image} 
					alt={title} 
					class="w-full h-auto object-cover aspect-video"
				/>
			</div>
		)}

		<div class="mb-8">
			<h1 class="font-bold text-3xl md:text-4xl mb-2">{title}</h1>

			<div class="flex flex-wrap items-center text-base-content/70 mb-4 text-sm">
				{author && (
					<span class="mr-4">{author}</span>
				)}
				<time class="mr-4" datetime={publish_date.toISOString()}>{formattedpublish_date}</time>
				{readingTime && (
					<span class="mr-4">{readingTime}</span>
				)}
				{update_date && (
					<span>更新于 <time datetime={update_date.toISOString()}>{formattedupdate_date}</time></span>
				)}
			</div>

			{tags.length > 0 && (
				<div class="flex flex-wrap gap-2 mb-6">
					{tags.map(tag => (
						<a href={`/blog/tag/${tag}`} class="badge badge-primary">
							{tag}
						</a>
					))}
				</div>
			)}
		</div>

		<div class="content">
			<slot />
		</div>
	</article>

	{enableComments && (
		<Giscus
			repo="paxie/xpx_blog"
			repoId="R_kgDOLjm_UQ"
			category="Comments"
			categoryId="DIC_kwDOLjm_Uc4Cd5vO"
			mapping="pathname"
			term=""
			reactionsEnabled={true}
			emitMetadata={false}
			inputPosition="top"
			theme="preferred_color_scheme"
			lang="zh-CN"
			loading="lazy"
		/>
	)}
</BaseLayout>

