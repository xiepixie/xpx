---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Analytics from '../components/Analytics.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import PagefindHighlight from '../components/PagefindHighlight.astro'
import { getPath } from '../lib/path'

interface Props {
    title: string
    description?: string
    image?: string
    type?: 'website' | 'article' | 'profile'
    publishDate?: Date | string
    updateDate?: Date | string
    author?: string
    tags?: string[]
    canonicalURL?: URL | string
}

const {
    title,
    description = '一个使用Astro构建的现代博客',
    image = '/placeholder-social.jpg',
    type = 'website',
    publishDate,
    updateDate,
    author,
    tags,
    canonicalURL = Astro.url,
} = Astro.props
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />

        <script is:inline>
            (function() {
                // 页面加载前立即应用主题，防止闪烁
                try {
                    // IndexedDB配置
                    const DB_NAME = 'xpxBlogThemeDB';
                    const DB_VERSION = 1;
                    const THEME_STORE = 'themes';
                    const THEME_KEY = 'currentTheme';
                    const DEFAULT_THEME = 'winter';

                    // 首先尝试从localStorage获取主题（快速路径）
                    const savedTheme = localStorage.getItem('theme');
                    const initialTheme = savedTheme || DEFAULT_THEME;

                    // 快速应用主题，避免不必要的DOM操作
                    document.documentElement.setAttribute('data-theme', initialTheme);
                    if (['dracula', 'synthwave', 'dark', 'night', 'coffee'].includes(initialTheme)) {
                        document.documentElement.classList.add('dark');
                    }

                    // 然后尝试从IndexedDB获取主题（可能更新）
                    const tryGetThemeFromIndexedDB = function() {
                        try {
                            const request = indexedDB.open(DB_NAME, DB_VERSION);

                            request.onerror = function() {
                                console.log('IndexedDB打开失败，使用localStorage主题');
                            };

                            request.onsuccess = function(event) {
                                try {
                                    const db = event.target.result;
                                    const transaction = db.transaction([THEME_STORE], 'readonly');
                                    const store = transaction.objectStore(THEME_STORE);
                                    const getRequest = store.get(THEME_KEY);

                                    getRequest.onsuccess = function(event) {
                                        const result = event.target.result;
                                        if (result && result.value) {
                                            const dbTheme = result.value;
                                            // 如果IndexedDB中的主题与初始应用的不同，则更新
                                            if (dbTheme !== initialTheme) {
                                                document.documentElement.setAttribute('data-theme', dbTheme);
                                                document.documentElement.classList.toggle('dark',
                                                    ['dracula', 'synthwave', 'dark', 'night', 'coffee'].includes(dbTheme));
                                            }
                                        }
                                    };

                                    transaction.oncomplete = function() {
                                        db.close();
                                    };
                                } catch (error) {
                                    console.error('IndexedDB事务错误:', error);
                                }
                            };

                            request.onupgradeneeded = function(event) {
                                const db = event.target.result;
                                if (!db.objectStoreNames.contains(THEME_STORE)) {
                                    db.createObjectStore(THEME_STORE, { keyPath: 'id' });
                                }
                            };
                        } catch (error) {
                            console.error('IndexedDB操作失败:', error);
                        }
                    };

                    // 在页面加载后尝试从IndexedDB获取主题
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', tryGetThemeFromIndexedDB);
                    } else {
                        tryGetThemeFromIndexedDB();
                    }

                    // 监听主题变化事件
                    document.addEventListener('theme-changed', function(e) {
                        const newTheme = e.detail.theme;

                        // 应用主题
                        document.documentElement.setAttribute('data-theme', newTheme);
                        document.documentElement.classList.toggle('dark',
                            ['dracula', 'synthwave', 'dark', 'night', 'coffee'].includes(newTheme));
                    });
                } catch (e) {
                    console.error('Theme preload error:', e);
                }
            })();
        </script>

        <!-- SEO 组件处理所有元标签和结构化数据 -->
        <SEO
            title={title}
            description={description}
            image={image}
            type={type}
            publishDate={publishDate}
            updateDate={updateDate}
            author={author}
            tags={tags}
            canonicalURL={canonicalURL}
        />

        <!-- 网站图标 -->
        <link rel="icon" type="image/svg+xml" href={getPath("favicon.svg")} />



        <!-- DNS 预解析 -->
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

        <!-- 预连接 -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />



        <!-- 允许在head中添加额外内容的插槽 -->
        <slot name="head" />

        <!-- 分析追踪 -->
        <Analytics />

        <!-- 基础路径脚本 -->
        <script is:inline src={getPath("scripts/base-path.js")}></script>

        <!-- 全局基础路径变量 -->
        <script is:inline define:vars={{ basePath: import.meta.env.PUBLIC_USE_BASE_PATH ? `/${import.meta.env.PUBLIC_BASE_PATH}` : '' }}>
            // 将基础路径暴露给客户端脚本
            window.xpxBlogBasePath = basePath;
        </script>

        <!-- 主题切换器脚本 -->
        <script is:inline src={getPath("scripts/theme-switcher-simple.js")}></script>

        <style>
            body {
                overflow-x: hidden;
                max-width: 100vw;
            }
            main {
                width: 100%;
                margin: 0 auto;
                padding: 0 1rem;
                max-width: 100%;
            }

            #page-loader {
                position: fixed;
                inset: 0;
                background-color: var(--fallback-b1, oklch(var(--b1) / 1)); /* Use DaisyUI base color */
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 1;
                transition: opacity 0.5s ease-out;
            }
            #page-loader.hidden {
                opacity: 0;
                pointer-events: none;
            }
             /* Add styles for your loading indicator if needed */
            .loader-content {
                 /* Example using DaisyUI spinner */
                color: var(--fallback-p, oklch(var(--p) / 1)); /* Primary color */
            }
        </style>
    </head>
    <body>
         {/* Loading Mask */}
        <div id="page-loader">
            <div class="loader-content">
                 {/* DaisyUI Spinner */}
                <span class="loading loading-spinner loading-lg"></span>
                {/* Or your custom loader */}
                 {/* <img class="mask mask-heart" src="https://img.daisyui.com/images/stock/photo-1567653418876-5bb0e566e1c2.webp" /> */}
            </div>
        </div>

        <Header />

        <main class="container mx-auto px-4 py-8 w-full max-w-full sm:max-w-screen-sm md:max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl 2xl:max-w-screen-2xl">
            <slot />
        </main>

        <!-- 添加Pagefind高亮功能 -->
        <PagefindHighlight />

        <footer class="bg-base-200 py-10 mt-16">
            <div class="container mx-auto px-4 max-w-full sm:max-w-screen-sm md:max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl 2xl:max-w-screen-2xl">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="flex flex-col space-y-4 items-start">
                        <h3 class="text-lg font-bold">关于我们</h3>
                        <p class="text-base-content/70">
                            这是一个使用Astro和DaisyUI构建的现代博客网站。分享最新的技术、设计和数字营销内容。
                        </p>
                    </div>

                    <div class="flex flex-col space-y-4">
                        <h3 class="text-lg font-bold">导航</h3>
                        <nav class="flex flex-row space-x-4">
                            <a
                                href={getPath('')}
                                class="hover:text-primary transition-colors"
                                >首页</a
                            >
                            <a
                                href={getPath('blog')}
                                class="hover:text-primary transition-colors"
                                >博客</a
                            >
                            <a
                                href={getPath('about')}
                                class="hover:text-primary transition-colors"
                                >关于</a
                            >
                            <a
                                href={getPath('contact')}
                                class="hover:text-primary transition-colors"
                                >联系</a
                            >
                        </nav>
                    </div>

                    <div class="flex flex-col space-y-4">
                        <h3 class="text-lg font-bold">联系我们</h3>
                        <div class="flex items-center space-x-4">
                            <a
                                href="https://twitter.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-base-content hover:text-primary"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                    ></path><path d="M9 18c-4.51 2-5-2-7-2"
                                    ></path></svg
                                >
                            </a>
                            <a
                                href="mailto:example@example.com"
                                class="text-base-content hover:text-primary"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><rect
                                        width="20"
                                        height="16"
                                        x="2"
                                        y="4"
                                        rx="2"></rect><path
                                        d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                    ></path></svg
                                >
                            </a>
                        </div>
                    </div>
                </div>

                <div class="mt-10 pt-8 border-t border-base-300 text-center text-base-content/70">
                    <p class="mb-4">页面已运行:</p>
                    <div class="flex justify-center gap-2 sm:gap-5" id="runtime-stats">
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-days" style="--value:0;" aria-label="0"></span>
                            </span>
                            天
                        </div>
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-hours" style="--value:0;" aria-label="0"></span>
                            </span>
                            时
                        </div>
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-min" style="--value:0;" aria-label="0"></span>
                            </span>
                            分
                        </div>
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-sec" style="--value:0;" aria-label="0"></span>
                            </span>
                            秒
                        </div>
                    </div>
                </div>

                <div
                    class="mt-10 pt-8 border-t border-base-300 text-center text-base-content/70"
                >
                    <p>
                        &copy; {new Date().getFullYear()} XPX Blog. All rights reserved.
                    </p>
                </div>
            </div>
        </footer>

         {/* Client-side scripts */}
         <script is:inline>
            // --- Page Loader ---
            function hideLoader() {
                 const loader = document.getElementById('page-loader');
                if (loader) {
                    loader.classList.add('hidden');
                    // Optional: Remove after transition ends
                    // setTimeout(() => loader.remove(), 500);
                }
            }
             // Hide loader when the main content is likely ready
            document.addEventListener('DOMContentLoaded', hideLoader);
             // Fallback if DOMContentLoaded is too early for complex pages
             // window.addEventListener('load', hideLoader);


            // --- Runtime Statistics ---
             // 运行时统计初始化
             const startTime = new Date('2025-03-14T00:00:00'); // 更新为2025年3月14日
             const daysEl = document.getElementById('runtime-days');
             const hoursEl = document.getElementById('runtime-hours');
             const minEl = document.getElementById('runtime-min');
             const secEl = document.getElementById('runtime-sec');

             // 检查元素是否存在，不存在则输出错误日志
             if (!daysEl) console.error('运行时统计元素未找到: #runtime-days');
             if (!hoursEl) console.error('运行时统计元素未找到: #runtime-hours');
             if (!minEl) console.error('运行时统计元素未找到: #runtime-min');
             if (!secEl) console.error('运行时统计元素未找到: #runtime-sec');

             let runtimeInterval;
             function updateRuntime() {
                if (!daysEl || !hoursEl || !minEl || !secEl) return;

                const now = Date.now();
                const diff = Math.floor((now - startTime) / 1000); // Difference in seconds

                const days = Math.floor(diff / (24 * 60 * 60));
                const hours = Math.floor((diff % (24 * 60 * 60)) / (60 * 60));
                const minutes = Math.floor((diff % (60 * 60)) / 60);
                const seconds = diff % 60;

                daysEl.style.setProperty('--value', days);
                 daysEl.setAttribute('aria-label', days.toString());
                hoursEl.style.setProperty('--value', hours);
                 hoursEl.setAttribute('aria-label', hours.toString());
                minEl.style.setProperty('--value', minutes);
                 minEl.setAttribute('aria-label', minutes.toString());
                secEl.style.setProperty('--value', seconds);
                 secEl.setAttribute('aria-label', seconds.toString());
            }

            // 初始化运行时统计
            updateRuntime();
            runtimeInterval = setInterval(updateRuntime, 1000);

            // SPA清理逻辑 - 在页面切换前清除计时器
            document.addEventListener('astro:before-swap', () => {
                console.log('清理运行时统计计时器');
                clearInterval(runtimeInterval);
            });

        </script>

    </body>
</html>
