---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Analytics from '../components/Analytics.astro'
import Footer from '../components/Footer.astro'; // Assuming Footer content is moved or refactored

interface Props {
    title: string
    description?: string
    image?: string
}

const {
    title,
    description = '一个使用Astro构建的现代博客',
    image = '/placeholder-social.jpg',
} = Astro.props
const pageLoadTime = new Date(); // Record load time on server (for potential SSR info)
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <!-- 网站图标 -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- 允许在head中添加额外内容的插槽 -->
        <slot name="head" />

        <!-- 分析追踪 -->
        <Analytics />

        <style>
            main {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 1rem;
            }
            
            #page-loader {
                position: fixed;
                inset: 0;
                background-color: var(--fallback-b1, oklch(var(--b1) / 1)); /* Use DaisyUI base color */
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 1;
                transition: opacity 0.5s ease-out;
            }
            #page-loader.hidden {
                opacity: 0;
                pointer-events: none;
            }
             /* Add styles for your loading indicator if needed */
            .loader-content {
                 /* Example using DaisyUI spinner */
                color: var(--fallback-p, oklch(var(--p) / 1)); /* Primary color */
            }
        </style>
    </head>
    <body>
         {/* Loading Mask */}
        <div id="page-loader">
            <div class="loader-content">
                 {/* DaisyUI Spinner */}
                <span class="loading loading-spinner loading-lg"></span>
                {/* Or your custom loader */}
                 {/* <img class="mask mask-heart" src="https://img.daisyui.com/images/stock/photo-1567653418876-5bb0e566e1c2.webp" /> */}
            </div>
        </div>

        <Header />

        <main class="container mx-auto px-4 py-8">
            <slot />
        </main>

        <footer class="bg-base-200 py-10 mt-16">
            <div class="container mx-auto px-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="flex flex-col space-y-4">
                        <h3 class="text-lg font-bold">关于我们</h3>
                        <p class="text-base-content/70">
                            这是一个使用Astro和DaisyUI构建的现代博客网站。分享最新的技术、设计和数字营销内容。
                        </p>
                    </div>

                    <div class="flex flex-col space-y-4">
                        <h3 class="text-lg font-bold">导航</h3>
                        <nav class="flex flex-row space-x-4">
                            <a
                                href="/"
                                class="hover:text-primary transition-colors"
                                >首页</a
                            >
                            <a
                                href="/blog"
                                class="hover:text-primary transition-colors"
                                >博客</a
                            >
                            <a
                                href="/about"
                                class="hover:text-primary transition-colors"
                                >关于</a
                            >
                            <a
                                href="/contact"
                                class="hover:text-primary transition-colors"
                                >联系</a
                            >
                        </nav>
                    </div>

                    <div class="flex flex-col space-y-4">
                        <h3 class="text-lg font-bold">联系我们</h3>
                        <div class="flex items-center space-x-4">
                            <a
                                href="https://twitter.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-base-content hover:text-primary"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
                                    ></path></svg
                                >
                            </a>
                            <a
                                href="https://github.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-base-content hover:text-primary"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                    ></path><path d="M9 18c-4.51 2-5-2-7-2"
                                    ></path></svg
                                >
                            </a>
                            <a
                                href="mailto:example@example.com"
                                class="text-base-content hover:text-primary"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><rect
                                        width="20"
                                        height="16"
                                        x="2"
                                        y="4"
                                        rx="2"></rect><path
                                        d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                    ></path></svg
                                >
                            </a>
                        </div>
                    </div>
                </div>

                <div class="mt-10 pt-8 border-t border-base-300 text-center text-base-content/70">
                    <p class="mb-4">页面已运行:</p>
                    <div class="flex justify-center gap-2 sm:gap-5" id="runtime-stats">
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-days" style="--value:0;" aria-label="0"></span>
                            </span>
                            天
                        </div>
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-hours" style="--value:0;" aria-label="0"></span>
                            </span>
                            时
                        </div>
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-min" style="--value:0;" aria-label="0"></span>
                            </span>
                            分
                        </div>
                        <div>
                            <span class="countdown font-mono text-xl sm:text-2xl">
                            <span id="runtime-sec" style="--value:0;" aria-label="0"></span>
                            </span>
                            秒
                        </div>
                    </div>
                </div>

                <div
                    class="mt-10 pt-8 border-t border-base-300 text-center text-base-content/70"
                >
                    <p>
                        &copy; {new Date().getFullYear()} XPX Blog. All rights reserved.
                    </p>
                </div>
            </div>
        </footer>

         {/* Client-side scripts */}
         <script is:inline>
            // --- Page Loader ---
            function hideLoader() {
                 const loader = document.getElementById('page-loader');
                if (loader) {
                    loader.classList.add('hidden');
                    // Optional: Remove after transition ends
                    // setTimeout(() => loader.remove(), 500);
                }
            }
             // Hide loader when the main content is likely ready
            document.addEventListener('DOMContentLoaded', hideLoader);
             // Fallback if DOMContentLoaded is too early for complex pages
             // window.addEventListener('load', hideLoader);


            // --- Runtime Statistics ---
             // 运行时统计初始化
             const startTime = new Date('2025-03-14T00:00:00'); // 更新为2025年3月14日
             const daysEl = document.getElementById('runtime-days');
             const hoursEl = document.getElementById('runtime-hours');
             const minEl = document.getElementById('runtime-min');
             const secEl = document.getElementById('runtime-sec');

             // 检查元素是否存在，不存在则输出错误日志
             if (!daysEl) console.error('运行时统计元素未找到: #runtime-days');
             if (!hoursEl) console.error('运行时统计元素未找到: #runtime-hours');
             if (!minEl) console.error('运行时统计元素未找到: #runtime-min');
             if (!secEl) console.error('运行时统计元素未找到: #runtime-sec');

             let runtimeInterval;
             function updateRuntime() {
                if (!daysEl || !hoursEl || !minEl || !secEl) return;

                const now = Date.now();
                const diff = Math.floor((now - startTime) / 1000); // Difference in seconds

                const days = Math.floor(diff / (24 * 60 * 60));
                const hours = Math.floor((diff % (24 * 60 * 60)) / (60 * 60));
                const minutes = Math.floor((diff % (60 * 60)) / 60);
                const seconds = diff % 60;

                daysEl.style.setProperty('--value', days);
                 daysEl.setAttribute('aria-label', days.toString());
                hoursEl.style.setProperty('--value', hours);
                 hoursEl.setAttribute('aria-label', hours.toString());
                minEl.style.setProperty('--value', minutes);
                 minEl.setAttribute('aria-label', minutes.toString());
                secEl.style.setProperty('--value', seconds);
                 secEl.setAttribute('aria-label', seconds.toString());
            }

            // 初始化运行时统计
            updateRuntime();
            runtimeInterval = setInterval(updateRuntime, 1000);

            // SPA清理逻辑 - 在页面切换前清除计时器
            document.addEventListener('astro:before-swap', () => {
                console.log('清理运行时统计计时器');
                clearInterval(runtimeInterval);
            });
        </script>
    </body>
</html>
<style is:global>
    /* Define CSS variables for Tailwind if needed */
    :root {
        --foreground: 0 0% 3.9%;
        --background: 0 0% 100%;
        --muted: 210 40% 96.1%;
        --muted-foreground: 215.4 16.3% 46.9%;
        --primary: 222.2 47.4% 11.2%;
        --primary-foreground: 210 40% 98%;
        --secondary: 210 40% 96.1%;
        --secondary-foreground: 222.2 47.4% 11.2%;
        --destructive: 0 84.2% 60.2%;
        --destructive-foreground: 210 40% 98%;
        --border: 214.3 31.8% 91.4%;
        --ring: 222.2 84% 4.9%;
    }
    .dark {
        --foreground: 210 4% 96%;
        --background: 222.2 84% 4.9%;
        --muted: 217.2 32.6% 17.5%;
        --muted-foreground: 215 20.2% 65.1%;
        --primary: 210 40% 98%;
        --primary-foreground: 222.2 47.4% 11.2%;
        --secondary: 217.2 32.6% 17.5%;
        --secondary-foreground: 210 40% 98%;
        --destructive: 0 62.8% 30.6%;
        --destructive-foreground: 210 40% 98%;
        --border: 217.2 32.6% 17.5%;
        --ring: 212.7 26.8% 83.9%;
    }

    /* Add other global styles if necessary */
</style>

