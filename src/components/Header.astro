---
import { useState, useEffect } from 'react';
import { Button } from './react/Button';
import { User, Sun, Moon, Menu as MenuIcon, X as XIcon, ChevronDown } from './react/Icons';
import clsx from 'clsx';
import { cn } from '../lib/utils';


interface NavItem {
	to?: string;
	text: string;
	items?: {
		icon?: {
			dark: string;
			light: string;
		};
		text: string;
		description?: string;
		to: string;
	}[];
}

export interface Props {
	logoText?: string;
	menuItems?: NavItem[];
	initialTheme?: 'valentine' | 'dracula' | 'winter' | 'synthwave';
}

const {
	logoText = "xpxBlog",
	menuItems = [
		{
			text: "Home",
			to: ""
		},
		{
			text: "Blog",
			to: "/blog"
		},
		{
			text: "Categories",
			items: [
				{
					text: "Technology",
					description: "Latest tech news and reviews",
					to: "/blog/tag/technology",
				},
				{
					text: "Marketing",
					description: "Digital marketing strategies",
					to: "/blog/tag/marketing",
				},
				{
					text: "Design",
					description: "UI/UX and graphic design",
					to: "/blog/tag/design",
				},
				{
					text: "SEO",
					description: "Search engine optimization tips",
					to: "/blog/tag/seo",
				},
				{
					text: "Content",
					description: "Content creation and management",
					to: "/blog/tag/content",
				}
			]
		},
		{
			text: "About",
			to: "/about"
		},
		{
			text: "Contact",
			to: "/contact"
		}
	],
	initialTheme = 'valentine'
} = Astro.props;

// 定义新的主题列表，与 theme-controller 对应
const themes = [
    { value: 'valentine', label: '浪漫粉' },
    { value: 'dracula', label: '暗黑' },
    { value: 'winter', label: '冬日' },
    { value: 'synthwave', label: '赛博朋克' },
    // 你可以根据需要添加更多 DaisyUI 主题
];
---

{/* 主题预加载脚本 - 放在头部防止闪烁 */}
<script is:inline>
    (function() {
        // 页面加载前立即应用主题，防止闪烁
        try {
            const getStoredTheme = function() {
                return localStorage.getItem('theme') || 'valentine';
            };
            
            const applyTheme = function(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.classList.toggle('dark', 
                    ['dracula', 'synthwave', 'dark', 'night', 'coffee'].includes(theme));
            };
            
            // 在DOM解析前就应用主题
            const currentTheme = getStoredTheme();
            applyTheme(currentTheme);
        } catch (e) {
            console.error('Theme preload error:', e);
        }
    })();
</script>

<script>
	document.addEventListener('astro:page-load', () => {
		const mobileMenuButton = document.getElementById('mobile-menu-button');
		const mobileMenuButtonMobile = document.getElementById('login-button-mobile');
		const mobileMenu = document.getElementById('mobile-menu');
		const loginButton = document.getElementById('login-button');
		const loginModal = document.getElementById('login-modal');
		const closeModalButton = document.getElementById('close-modal');
		const loginForm = document.getElementById('login-form') as HTMLFormElement;
		const dropdownButtons = document.querySelectorAll('.dropdown-button');
		const dropdownMenus = document.querySelectorAll('.dropdown-menu');

		// --- 主题切换逻辑 (使用 theme-controller) ---
		const getStoredTheme = (): string => {
            try {
                return localStorage.getItem('theme') || 'valentine';
            } catch (error) {
                console.error('Error reading theme from localStorage:', error);
                return 'valentine';
            }
        };

		const applyTheme = (theme: string) => {
			document.documentElement.setAttribute('data-theme', theme);
			// 根据常见暗色主题名称判断是否添加 dark 类
			document.documentElement.classList.toggle('dark', ['dracula', 'synthwave', 'dark', 'night', 'coffee'].includes(theme));
            
            // 强制重新应用样式以确保所有组件正确刷新
            const bodyElement = document.body;
            if (bodyElement) {
                // 添加临时类触发重新布局
                bodyElement.classList.add('theme-refreshing');
                
                // 在下一帧移除临时类触发重新渲染
                requestAnimationFrame(() => {
                    bodyElement.classList.remove('theme-refreshing');
                });
            }
		};

		// 初始化主题
		const currentTheme = getStoredTheme();
		applyTheme(currentTheme);

		// 监听 theme-controller 变化并持久化
		const themeControllers = document.querySelectorAll('input[name="theme-buttons"]');
		themeControllers.forEach(controller => {
			const radio = controller as HTMLInputElement;
			// 设置初始选中状态
			if (radio.value === currentTheme) {
				radio.checked = true;
			}

			radio.addEventListener('change', (e) => {
				const newTheme = (e.target as HTMLInputElement).value;
				applyTheme(newTheme); // 应用新主题
				try {
					localStorage.setItem('theme', newTheme); // 保存到 localStorage
					
					// 触发主题变化事件，通知其他组件（如FloatingMenu）
                    const themeChangedEvent = new CustomEvent('theme-changed', {
                        detail: { theme: newTheme },
                        bubbles: true
                    });
                    document.dispatchEvent(themeChangedEvent);
				} catch (error) {
					console.error('Error saving theme to localStorage:', error);
				}
			});
		});
		// --- 主题切换逻辑结束 ---

		// 移动菜单切换
		if (mobileMenuButton && mobileMenu) { // 添加 mobileMenu 存在性检查
			mobileMenuButton.addEventListener('click', (e) => {
                e.stopPropagation(); // 阻止事件冒泡到 document click listener
				mobileMenu.classList.toggle('hidden');
                // 可选：切换按钮图标
                // const icon = mobileMenuButton.querySelector('svg');
                // if (icon) {
                //     // 这里需要根据 hidden 状态切换 XIcon 和 MenuIcon 的 SVG 内容或类名
                // }
			});
		}

		// 登录模态框处理
		const openLoginModal = () => {
			loginModal?.classList.remove('hidden');
		};

        const closeLoginModal = () => {
            loginModal?.classList.add('hidden');
        };

		loginButton?.addEventListener('click', openLoginModal);
		mobileMenuButtonMobile?.addEventListener('click', () => {
            openLoginModal();
            mobileMenu?.classList.add('hidden'); // 打开登录框时关闭移动菜单
        });

		closeModalButton?.addEventListener('click', closeLoginModal);

		// 处理登录表单提交
		loginForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			const formData = new FormData(loginForm);
			const email = formData.get('email');
			const password = formData.get('password');

			// 这里添加登录逻辑，例如API调用
			console.log('Login attempt:', { email, password });

			// 模拟登录成功
			alert('登录成功！');
			closeLoginModal();
		});

		// 点击模态框外部关闭
		loginModal?.addEventListener('click', (e) => {
			if (e.target === loginModal) {
				closeLoginModal();
			}
		});

		// 移动端下拉菜单处理
		dropdownButtons.forEach((button, index) => {
			button.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation();

				const menu = dropdownMenus[index];
                const isHidden = menu.classList.contains('hidden');

				// 先关闭其他所有菜单
				dropdownMenus.forEach((otherMenu, otherIndex) => {
                    if (otherIndex !== index) {
					    otherMenu.classList.add('hidden');
                    }
				});

				// 切换当前菜单
                if (isHidden) {
                    menu.classList.remove('hidden');
                } else {
                    menu.classList.add('hidden');
                }
			});
		});

		// 点击页面其他地方关闭移动菜单和下拉菜单
		document.addEventListener('click', (e) => {
            // 关闭移动菜单
            if (mobileMenu && !mobileMenu.contains(e.target as Node) && mobileMenuButton && !mobileMenuButton.contains(e.target as Node)) {
                mobileMenu.classList.add('hidden');
            }

            // 关闭下拉菜单
			dropdownMenus.forEach((menu) => {
                // 检查点击是否发生在菜单或其触发按钮内部
                const correspondingButton = Array.from(dropdownButtons).find((btn, idx) => dropdownMenus[idx] === menu);
                if (!menu.contains(e.target as Node) && correspondingButton && !correspondingButton.contains(e.target as Node)) {
				    menu.classList.add('hidden');
                }
			});
		});

        // 搜索逻辑
        const searchInputs = document.querySelectorAll('input[type="text"][placeholder="Search blog..."]');
        const searchButtons = document.querySelectorAll('button.btn-primary.join-item');
        
        // 搜索预览功能
        searchInputs.forEach((input) => {
            const inputElement = input as HTMLInputElement;
            const searchContainer = inputElement.closest('.search-container');
            const previewContainer = searchContainer?.querySelector('.search-preview');
            
            if (inputElement && previewContainer) {
                inputElement.addEventListener('input', () => {
                    const query = inputElement.value.trim();
                    
                    if (query.length >= 2) {
                        // 显示搜索预览
                        previewContainer.classList.remove('hidden');
                        previewContainer.classList.add('visible', 'opacity-100', 'scale-100');
                        
                        // 这里可以添加实际的搜索预览逻辑，例如API调用
                        // 简单模拟一些搜索结果
                        previewContainer.innerHTML = `
                            <div class="p-2 hover:bg-base-200 rounded-lg">
                                <a href="/blog/post-1" class="block">
                                    <div class="font-medium">Blog post with "${query}" 1</div>
                                    <div class="text-xs text-base-content/70">This is a technical article...</div>
                                </a>
                            </div>
                            <div class="p-2 hover:bg-base-200 rounded-lg">
                                <a href="/blog/post-2" class="block">
                                    <div class="font-medium">Another post with "${query}"</div>
                                    <div class="text-xs text-base-content/70">Exploring the latest industry trends...</div>
                                </a>
                            </div>
                            <div class="text-center py-2 border-t">
                                <a href="/search?q=${encodeURIComponent(query)}" class="text-primary text-sm">
                                    View all results
                                </a>
                            </div>
                        `;
                    } else if (previewContainer) {
                        previewContainer.classList.add('hidden');
                        previewContainer.classList.remove('visible', 'opacity-100', 'scale-100');
                    }
                });
                
                // 点击其他地方关闭预览
                document.addEventListener('click', (e) => {
                    if (!inputElement.contains(e.target as Node) && 
                        !previewContainer.contains(e.target as Node)) {
                        previewContainer.classList.add('hidden');
                        previewContainer.classList.remove('visible', 'opacity-100', 'scale-100');
                    }
                });
            }
        });

        // 搜索按钮点击事件
        searchButtons.forEach((button, index) => {
            const htmlButton = button as HTMLElement;
            htmlButton.addEventListener('click', () => {
                const input = searchInputs[index] as HTMLInputElement;
                const query = input.value.trim();
                if (query) {
                    console.log('搜索:', query);
                    // 实际搜索跳转
                    window.location.href = `/search?q=${encodeURIComponent(query)}`;
                }
            });
            
            // 允许在输入框中按回车进行搜索
            const input = searchInputs[index] as HTMLInputElement;
            input?.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    htmlButton.click();
                }
            });
        });
	});
</script>

<header class={cn(
	'relative z-40 w-full sticky top-0',
	'bg-base-100/80 backdrop-blur-md',
	'border-b border-base-300',
)}>
	<div class="mx-auto max-w-[1760px] px-5 py-4">
		<div class="flex items-center justify-between">
			<div class="flex items-center space-x-8">
				{/* 左侧 Logo */}
				<a href="/" class="text-xl font-bold text-base-content">{logoText}</a>

				{/* 左侧导航 (仅桌面可见) */}
				<nav class="hidden md:block">
					<ul class="flex gap-x-6">
						{menuItems.filter((item) => !item.items).map((item) => (
							<li class="relative h-10 flex items-center">
								<a href={item.to} class="flex h-10 items-center whitespace-pre text-base text-base-content hover:text-primary transition-colors duration-200">
									{item.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			{/* 中间搜索框 (仅桌面可见) */}
			<div class="hidden md:block flex-1 max-w-xl mx-auto">
				<div class="search-container relative">
					<div class="input-group relative flex items-center">
						<input type="text" placeholder="Search blog..." class="input input-bordered w-full focus:outline-primary transition-all duration-300 ease-in-out focus:ring-2 focus:ring-primary/20" />
						<button class="btn btn-primary join-item absolute right-0 top-0 h-full">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
						</button>
					</div>
					
					{/* 搜索预览容器 */}
					<div class="search-preview hidden absolute top-full left-0 right-0 mt-1 bg-base-100 border border-base-300 rounded-lg shadow-lg z-50 max-h-[300px] overflow-y-auto transition-all duration-300 ease-in-out transform origin-top opacity-0 scale-95">
						{/* JavaScript 会动态填充搜索结果 */}
					</div>
				</div>
			</div>

			{/* 右侧功能区 */}
			<div class="flex items-center gap-x-2 md:gap-x-4">
				{/* 导航下拉菜单 (仅显示有子菜单的项目) */}
				<nav class="hidden lg:block">
					<ul class="flex gap-x-4">
						{menuItems.filter((item) => item.items && item.items.length > 0).map((item) => (
							<li class="relative group h-10 flex items-center">
								<button class="btn btn-ghost h-10 px-4 flex items-center gap-1 min-h-0 text-base capitalize font-normal">
									{item.text}
									<ChevronDown className="w-4 h-4 opacity-60 transition-transform duration-300 group-hover:rotate-180" />
								</button>
								<div class={clsx(
									'absolute -left-5 top-full w-[300px] pt-5',
									'pointer-events-none opacity-0 invisible',
									'origin-top-left transition-all duration-300 ease-out transform scale-95',
									'group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100 group-hover:scale-100'
								)}>
									<ul class={clsx(
										'relative flex min-w-[248px] flex-col gap-y-0.5 rounded-[14px] border p-2.5',
										'border-base-300 bg-base-100 shadow-lg'
									)}>
										{item.items?.map((subItem) => (
											<li>
												<a href={subItem.to} class={clsx(
													'group/link relative flex items-center overflow-hidden whitespace-nowrap rounded-[14px] p-2',
													'before:absolute before:inset-0 before:z-10 before:opacity-0 before:transition-opacity before:duration-200 hover:before:opacity-100',
													'text-base-content before:bg-base-200 hover:text-primary transition-colors duration-200'
												)}>
													<div class="relative z-10 ml-3">
														<span class="block text-sm font-medium">{subItem.text}</span>
														{subItem.description && (
															<span class="mt-0.5 block text-sm text-base-content/70">
																{subItem.description}
															</span>
														)}
													</div>
												</a>
											</li>
										))}
									</ul>
								</div>
							</li>
						))}
					</ul>
				</nav>

				{/* 主题切换 */}
				<div class="dropdown dropdown-end">
					<div tabindex="0" role="button" class="btn btn-ghost btn-circle">
						<div class="indicator">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-palette"><circle cx="13.5" cy="6.5" r="2.5"/><path d="M19 2.5H5a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-14a3 3 0 0 0-3-3Z"/><path d="M13.5 16.5h2a2 2 0 0 0 2-2v-2"/><path d="M2 12.5h5.5"/><path d="M8 16.5h3"/><path d="M2 8.5h3"/></svg>
						</div>
					</div>
					<div tabindex="0" class="mt-3 z-50 card dropdown-content shadow bg-base-100 rounded-box w-60 max-h-96 overflow-y-auto">
						<div class="card-body p-4">
							<h3 class="font-bold text-lg mb-2">选择主题</h3>
							<div class="join join-vertical w-full">
                                {themes.map(theme => (
                                    <input
                                        type="radio"
                                        name="theme-buttons"
                                        class="btn theme-controller join-item"
                                        aria-label={theme.label}
                                        value={theme.value}
                                    />
                                ))}
							</div>
						</div>
					</div>
				</div>

				{/* 登录按钮 (桌面端) */}
				<Button client:load variant="primary" id="login-button" className="bg-primary hover:bg-primary-focus text-primary-content hidden md:flex">
					<User className="mr-2 h-4 w-4" />
					登录
				</Button>

				{/* 移动菜单按钮 */}
				<button id="mobile-menu-button" class="btn btn-ghost btn-circle lg:hidden">
                     <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 menu-icon"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
				</button>
			</div>
		</div>
	</div>

	{/* 移动菜单（默认隐藏） */}
	<div id="mobile-menu" class="hidden lg:hidden absolute top-full left-0 w-full bg-base-100 border-t border-base-300 shadow-lg">
		<ul class="menu p-4 w-full">
            {/* 移动端搜索框 */}
            <li class="mb-4">
                <div class="search-container relative">
                    <div class="input-group relative flex items-center">
                        <input type="text" placeholder="搜索博客..." class="input input-bordered w-full transition-all duration-300 ease-in-out focus:ring-2 focus:ring-primary/20" />
                        <button class="btn btn-square absolute right-0 top-0 h-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </button>
                    </div>
                    
                    {/* 移动端搜索预览 */}
                    <div class="search-preview hidden absolute top-full left-0 right-0 mt-1 bg-base-100 border border-base-300 rounded-lg shadow-lg z-50 max-h-[300px] overflow-y-auto transition-all duration-300 ease-in-out transform origin-top opacity-0 scale-95">
                        {/* JavaScript 会动态填充搜索结果 */}
                    </div>
                </div>
            </li>
			{menuItems.map((item) => (
				<li>
					{item.to ? (
						<a href={item.to} class="text-base-content py-3">{item.text}</a>
					) : (
						<div class="w-full">
							<button class="dropdown-button w-full flex justify-between items-center text-base-content py-3">
								{item.text}
								<ChevronDown className="w-4 h-4 transition-transform duration-200" />
							</button>
							<ul class="dropdown-menu hidden pl-4 py-2 space-y-2">
								{item.items?.map((subItem) => (
									<li>
										<a href={subItem.to} class="block py-2 text-base-content/80 hover:text-primary">
											{subItem.text}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}
				</li>
			))}
			{/* 移动端登录按钮 */}
			<li class="mt-4">
				<Button client:load variant="primary" id="login-button-mobile" className="bg-primary hover:bg-primary-focus text-primary-content w-full justify-center">
					<User className="mr-2 h-4 w-4" />
					登录
				</Button>
			</li>
		</ul>
	</div>
</header>

{/* 登录模态框 */}
<div id="login-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
	<div class="bg-base-100 rounded-lg shadow-xl p-6 w-full max-w-md mx-4">
		<div class="flex justify-between items-center mb-4">
			<h3 class="text-xl font-bold text-base-content">用户登录</h3>
			<button id="close-modal" class="text-base-content/70 hover:text-base-content">
				<XIcon className="h-6 w-6" />
			</button>
		</div>
		<form id="login-form" class="space-y-4">
			<div>
				<label for="email" class="block text-sm font-medium text-base-content mb-1">邮箱</label>
				<input type="email" id="email" name="email" required class="w-full px-3 py-2 border border-base-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary" />
			</div>
			<div>
				<label for="password" class="block text-sm font-medium text-base-content mb-1">密码</label>
				<input type="password" id="password" name="password" required class="w-full px-3 py-2 border border-base-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary" autocomplete="current-password"/>
			</div>
			<div class="flex items-center justify-between">
				<div class="flex items-center">
					<input id="remember" name="remember" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-base-300 rounded" />
					<label for="remember" class="ml-2 block text-sm text-base-content">记住我</label>
				</div>
				<a href="#" class="text-sm text-primary hover:text-primary-focus">忘记密码？</a>
			</div>
			<div>
				<button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-primary-content bg-primary hover:bg-primary-focus focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
					登录
				</button>
