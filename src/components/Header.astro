---
import { X as XIcon, ChevronDown } from './react/Icons';
import { cn } from '../lib/utils';
import { getPath } from '../lib/path';
import SearchModal from './SearchModal.astro';

interface NavItem {
	to?: string;
	text: string;
	items?: {
		icon?: {
			dark: string;
			light: string;
		};
		text: string;
		description?: string;
		to: string;
	}[];
}

export interface Props {
	logoText?: string;
	menuItems?: NavItem[];
	initialTheme?: 'valentine' | 'dracula' | 'winter' | 'synthwave';
}


const {
	logoText = "xpxBlog",
	menuItems = [
		{
			text: "Home",
			to: "/"
		},
		{
			text: "Blog",
			to: "/blog"
		},
		{
			text: "专栏",
			items: [
				{
					text: "技术",
					description: "最新技术新闻和评测",
					to: "/blog/tag/technology",
				},
				{
					text: "营销",
					description: "数字营销策略",
					to: "/blog/tag/marketing",
				},
				{
					text: "教程",
					description: "UI/UX和图形设计",
					to: "/blog/tag/tutorial",
				},
				{
					text: "SEO",
					description: "搜索引擎优化技巧",
					to: "/blog/tag/seo",
				},
				{
					text: "内容",
					description: "内容创作和管理",
					to: "/blog/tag/content",
				}
			]
		},
		{
			text: "About",
			to: "/about"
		},
		{
			text: "Contact",
			to: "/contact"
		}
	],
} = Astro.props;

// 确保所有菜单项的链接都使用正确的基础路径
const processedMenuItems = menuItems.map(item => {
    if (item.to !== undefined) {
        return {
            ...item,
            to: item.to ? getPath(item.to) : getPath('')
        };
    }

    if (item.items) {
        return {
            ...item,
            items: item.items.map(subItem => ({
                ...subItem,
                to: getPath(subItem.to)
            }))
        };
    }

    return item;
});

// 定义主题配置
const themes = [
    { value: 'valentine', label: '浪漫粉', icon: '🌸' },
    { value: 'dracula', label: '暗黑', icon: '🦇' },
    { value: 'winter', label: '冬日', icon: '❄️' },
    { value: 'synthwave', label: '赛博朋克', icon: '🌃' },
];

---


<script>
	// 为 window 对象添加 openLoginModal 方法的类型定义
	declare global {
		interface Window {
			openLoginModal: () => void;
		}
	}

	document.addEventListener('astro:page-load', () => {

		// 登录模态框处理
		const loginModal = document.getElementById('login-modal') as HTMLDialogElement;
		const loginForm = document.getElementById('login-form') as HTMLFormElement;

		// --- 主题切换逻辑 (使用 IndexedDB) ---
		// IndexedDB配置
		const DB_NAME = 'xpxBlogThemeDB';
		const DB_VERSION = 1;
		const THEME_STORE = 'themes';
		const THEME_KEY = 'currentTheme';
		const DEFAULT_THEME = 'winter';

		// 从IndexedDB获取主题
		const getThemeFromIndexedDB = (): Promise<string> => {
			return new Promise((resolve) => {
				try {
					const request = indexedDB.open(DB_NAME, DB_VERSION);

					request.onerror = () => {
						console.error('[Header] 打开IndexedDB失败，尝试备用方法');
						resolve(getFallbackTheme());
					};

					request.onsuccess = (event) => {
						try {
							const db = (event.target as IDBOpenDBRequest).result;
							const transaction = db.transaction([THEME_STORE], 'readonly');
							const store = transaction.objectStore(THEME_STORE);
							const getRequest = store.get(THEME_KEY);

							getRequest.onsuccess = (event) => {
								const result = (event.target as IDBRequest).result;
								if (result && result.value) {
									console.log('[Header] 从IndexedDB获取主题:', result.value);
									resolve(result.value);
								} else {
									console.log('[Header] IndexedDB中未找到主题，使用备用方法');
									resolve(getFallbackTheme());
								}
							};

							getRequest.onerror = () => {
								console.error('[Header] 从IndexedDB获取主题失败，尝试备用方法');
								resolve(getFallbackTheme());
							};

							transaction.oncomplete = () => {
								db.close();
							};
						} catch (error) {
							console.error('[Header] IndexedDB事务错误:', error);
							resolve(getFallbackTheme());
						}
					};

					request.onupgradeneeded = (event) => {
						const db = (event.target as IDBOpenDBRequest).result;
						if (!db.objectStoreNames.contains(THEME_STORE)) {
							db.createObjectStore(THEME_STORE, { keyPath: 'id' });
							console.log('[Header] 主题存储对象创建成功');
						}
					};
				} catch (error) {
					console.error('[Header] IndexedDB操作失败:', error);
					resolve(getFallbackTheme());
				}
			});
		};

		// 获取备用主题（从localStorage或cookie）
		const getFallbackTheme = (): string => {
			try {
				// 尝试从localStorage获取
				const localTheme = localStorage.getItem('theme');
				if (localTheme) {
					return localTheme;
				}

				// 尝试从cookie获取
				const themeCookie = document.cookie
					.split('; ')
					.find(row => row.startsWith('theme='));

				if (themeCookie) {
					return themeCookie.split('=')[1];
				}
			} catch (e) {
				console.error('[Header] 获取备用主题失败:', e);
			}

			// 默认主题
			return DEFAULT_THEME;
		};

		// 获取存储的主题 - 优先使用IndexedDB，然后回退到localStorage和cookie
		const getStoredTheme = async (): Promise<string> => {
			try {
				// 尝试从IndexedDB获取
				const theme = await getThemeFromIndexedDB();
				return theme;
			} catch (error) {
				console.error('[Header] 从IndexedDB获取主题失败，尝试备用方法:', error);
				return getFallbackTheme();
			}
		};

		// 保存主题到IndexedDB
		const saveThemeToIndexedDB = (theme: string): Promise<void> => {
			return new Promise((resolve, reject) => {
				try {
					const request = indexedDB.open(DB_NAME, DB_VERSION);

					request.onerror = (event) => {
						console.error('[Header] 打开IndexedDB失败:', event);
						reject(new Error('无法打开主题数据库'));
					};

					request.onsuccess = (event) => {
						const db = (event.target as IDBOpenDBRequest).result;
						const transaction = db.transaction([THEME_STORE], 'readwrite');
						const store = transaction.objectStore(THEME_STORE);

						const themeData = {
							id: THEME_KEY,
							value: theme,
							timestamp: Date.now()
						};

						const putRequest = store.put(themeData);

						putRequest.onsuccess = () => {
							console.log('[Header] 主题已保存到IndexedDB:', theme);
							resolve();
						};

						putRequest.onerror = (event) => {
							console.error('[Header] 保存主题到IndexedDB失败:', event);
							reject(new Error('保存主题失败'));
						};

						transaction.oncomplete = () => {
							db.close();
						};
					};

					request.onupgradeneeded = (event) => {
						const db = (event.target as IDBOpenDBRequest).result;
						if (!db.objectStoreNames.contains(THEME_STORE)) {
							db.createObjectStore(THEME_STORE, { keyPath: 'id' });
						}
					};
				} catch (error) {
					console.error('[Header] IndexedDB操作失败:', error);
					reject(error);
				}
			});
		};

		// 全面保存主题到所有存储位置
		const saveThemeEverywhere = async (theme: string): Promise<void> => {
			try {
				// 保存到IndexedDB
				await saveThemeToIndexedDB(theme);

				// 同时保存到localStorage作为备份
				localStorage.setItem('theme', theme);

				// 同时保存到cookie (7天过期)
				const expiryDate = new Date();
				expiryDate.setDate(expiryDate.getDate() + 7);
				document.cookie = `theme=${theme}; expires=${expiryDate.toUTCString()}; path=/; SameSite=Lax`;

				console.log('[Header] 主题已保存到所有存储位置:', theme);
			} catch (error) {
				console.error('[Header] 保存主题失败:', error);
				// 出错时至少尝试保存到localStorage
				try {
					localStorage.setItem('theme', theme);
				} catch (e) {
					console.error('[Header] 回退到localStorage也失败:', e);
				}
			}
		};

		const applyTheme = (theme: string): void => {
			// 安全检查，确保文档已准备好
			if (!document || !document.documentElement) {
				console.warn('[Header] 文档尚未准备好，无法应用主题');
				return;
			}

			// 设置 data-theme 属性
			document.documentElement.setAttribute('data-theme', theme);

			// 根据暗色主题名称判断是否添加 dark 类
			const darkThemes = ['dracula', 'synthwave', 'dark', 'night', 'coffee'];
			document.documentElement.classList.toggle('dark', darkThemes.includes(theme));

			// 强制重新应用样式以确保所有组件正确刷新
			if (document.body) {
				// 添加临时类触发重新布局
				document.body.classList.add('theme-refreshing');

				// 在下一帧移除临时类触发重新渲染
				requestAnimationFrame(() => {
					document.body.classList.remove('theme-refreshing');
				});
			}

			// 防止可能的扩展冲突
			setTimeout(() => {
				// 再次确认主题已正确应用
				if (document.documentElement.getAttribute('data-theme') !== theme) {
					console.warn('[Header] 主题应用可能被干扰，重新应用');
					document.documentElement.setAttribute('data-theme', theme);
				}
			}, 100);
		};

		// 初始化主题
		const initTheme = async (): Promise<void> => {
			try {
				const theme = await getStoredTheme();
				applyTheme(theme);

				// 设置初始选中状态
				const themeControllers = document.querySelectorAll('input[name="theme-buttons"]');
				themeControllers.forEach(controller => {
					const radio = controller as HTMLInputElement;
					if (radio.value === theme) {
						radio.checked = true;
					}
				});
			} catch (error) {
				console.error('[Header] 初始化主题失败:', error);
				// 出错时使用默认主题
				applyTheme(DEFAULT_THEME);
			}
		};

		// 初始化主题
		initTheme();

		// 监听 theme-controller 变化并持久化
		document.addEventListener('change', (e) => {
			const target = e.target as HTMLInputElement;
			if (target.name === 'theme-buttons' && target.classList.contains('theme-controller')) {
				const newTheme = target.value;
				console.log('[Header] 主题变更:', newTheme);

				// 保存主题
				saveThemeEverywhere(newTheme);

				// 应用新主题
				applyTheme(newTheme);

				// 触发主题变化事件，通知其他组件
				const themeChangedEvent = new CustomEvent('theme-changed', {
					detail: { theme: newTheme },
					bubbles: true
				});
				document.dispatchEvent(themeChangedEvent);
			}
		});
		// --- 主题切换逻辑结束 ---

		// 确保登录模态框正确初始化
		if (loginModal) {
			// 添加打开模态框的方法
			window.openLoginModal = () => {
				try {
					if (loginModal && typeof loginModal.showModal === 'function') {
						loginModal.showModal();
					} else {
						console.error('[Header] 登录模态框不支持 showModal 方法');
					}
				} catch (error) {
					console.error('[Header] 打开登录模态框时出错:', error);
				}
			};

			// 处理登录表单提交
			loginForm?.addEventListener('submit', (e) => {
				e.preventDefault();
				const formData = new FormData(loginForm);
				const email = formData.get('email');
				const password = formData.get('password');

				// 这里添加登录逻辑，例如API调用
				console.log('[Header] 登录尝试:', { email, password });

				// 模拟登录成功
				alert('登录成功！');

				// 安全地关闭模态框
				try {
					if (loginModal && typeof loginModal.close === 'function') {
						loginModal.close();
					}
				} catch (error) {
					console.error('[Header] 关闭登录模态框时出错:', error);
				}
			});
		} else {
			console.warn('[Header] 登录模态框元素未找到');
		}

		// 为移动端下拉菜单添加动画效果
		const detailsElements = document.querySelectorAll('details');
		detailsElements.forEach(details => {
			// 添加过渡动画
			details.addEventListener('toggle', () => {
				const summary = details.querySelector('summary');
				const content = details.querySelector('ul');

				if (details.open) {
					// 打开时的动画
					if (summary) {
						const chevron = summary.querySelector('svg');
						if (chevron) {
							chevron.classList.add('rotate-180');
							chevron.style.transform = 'rotate(180deg)';
						}
					}

					if (content) {
						content.classList.add('animate-fadeIn');
					}
				} else {
					// 关闭时的动画
					if (summary) {
						const chevron = summary.querySelector('svg');
						if (chevron) {
							chevron.classList.remove('rotate-180');
							chevron.style.transform = 'rotate(0deg)';
						}
					}

					if (content) {
						content.classList.remove('animate-fadeIn');
					}
				}
			});
		});

		// 添加全局样式以支持动画 - 使用更安全的方式
		try {
			// 检查是否已存在相同ID的样式元素
			const styleId = 'header-animation-styles';
			let styleElement = document.getElementById(styleId) as HTMLStyleElement;

			// 如果不存在，创建新的样式元素
			if (!styleElement) {
				styleElement = document.createElement('style');
				styleElement.id = styleId;
				styleElement.textContent = `
					@keyframes fadeIn {
						from { opacity: 0; transform: translateY(-10px); }
						to { opacity: 1; transform: translateY(0); }
					}
					.animate-fadeIn {
						animation: fadeIn 0.2s ease-out forwards;
					}
					.dropdown-content {
						transform-origin: top;
						transition: transform 0.2s ease, opacity 0.2s ease;
					}
					summary svg {
						transition: transform 0.3s ease;
					}
				`;

				// 安全地添加到文档
				if (document.head) {
					document.head.appendChild(styleElement);
				} else if (document.body) {
					// 如果 head 不可用，尝试添加到 body
					document.body.appendChild(styleElement);
				} else {
					console.warn('[Header] 无法添加动画样式：document.head 和 document.body 均不可用');
				}
			}
		} catch (error) {
			console.error('[Header] 添加动画样式时出错:', error);
		}
	});
</script>

<header class={cn(
	'sticky z-40 w-full top-0',
	'bg-base-100/90 backdrop-blur-md',
	'border-b border-base-300 shadow-sm',
)}>
	<div class="container mx-auto px-4 py-2">
		<div class="navbar min-h-0 h-auto py-2">
			{/* Logo 区域 */}
			<div class="navbar-start">
				<a href={getPath('')} class="btn btn-ghost px-2 md:px-4 normal-case text-xl font-bold text-base-content hover:bg-base-200/50">
					{logoText}
				</a>
			</div>

			{/* 中间导航区域 - 桌面端 */}
			<div class="navbar-center hidden md:flex">
				<ul class="menu menu-horizontal px-1 gap-1">
					{processedMenuItems.filter((item) => !item.items).map((item) => (
						<li>
							<a href={item.to} class="rounded-lg text-base hover:bg-base-200/70 hover:text-primary transition-all duration-200">
								{item.text}
							</a>
						</li>
					))}

					{/* 下拉菜单项 */}
					{processedMenuItems.filter((item) => item.items && item.items.length > 0).map((item) => (
						<li>
							<details class="dropdown">
								<summary class="rounded-lg text-base hover:bg-base-200/70 hover:text-primary transition-all duration-200 flex gap-1 items-center">
									{item.text}
									<ChevronDown className="w-4 h-4 opacity-70 transition-transform duration-300" />
								</summary>
								<ul class="dropdown-content z-[1] menu p-2 shadow-lg bg-base-100 rounded-box w-72 mt-4">
									{item.items?.map((subItem) => (
										<li>
											<a href={subItem.to} class="hover:bg-base-200/70 hover:text-primary transition-all duration-200">
												<div>
													<div class="font-medium">{subItem.text}</div>
													{subItem.description && (
														<div class="text-xs opacity-70">{subItem.description}</div>
													)}
												</div>
											</a>
										</li>
									))}
								</ul>
							</details>
						</li>
					))}
				</ul>
			</div>

			{/* 右侧功能区 */}
			<div class="navbar-end">
				{/* 主题切换 */}
				<div class="dropdown dropdown-end">
					<div tabindex="0" role="button" class="btn btn-ghost btn-circle">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-palette"><circle cx="13.5" cy="6.5" r="2.5"/><path d="M19 2.5H5a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-14a3 3 0 0 0-3-3Z"/><path d="M13.5 16.5h2a2 2 0 0 0 2-2v-2"/><path d="M2 12.5h5.5"/><path d="M8 16.5h3"/><path d="M2 8.5h3"/></svg>
					</div>
					<div tabindex="0" class="dropdown-content z-[1] card shadow-lg bg-base-100 rounded-box w-64 mt-4">
						<div class="card-body p-4">
							<h3 class="card-title text-lg mb-2">选择主题</h3>
							<div class="grid grid-cols-2 gap-2">
								{themes.map(theme => (
									<label class="flex cursor-pointer gap-2 items-center p-2 rounded-box hover:bg-base-200 transition-all duration-200">
										<span class="text-xl">{theme.icon}</span>
										<span class="flex-1">{theme.label}</span>
										<input
											type="radio"
											name="theme-buttons"
											class="theme-controller radio radio-sm radio-primary"
											value={theme.value}
										/>
									</label>
								))}
							</div>
						</div>
					</div>
				</div>

				{/* 移动菜单按钮 */}
				<div class="dropdown dropdown-end md:hidden">
					<div tabindex="0" role="button" id="mobile-menu-button" class="btn btn-ghost btn-circle">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 menu-icon"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
					</div>
					<div tabindex="0" id="mobile-menu" class="dropdown-content z-[1] menu menu-sm p-2 shadow-lg bg-base-100 rounded-box w-72 mt-4">
						{processedMenuItems.map((item) => (
							<li>
								{item.to ? (
									<a href={item.to} class="hover:bg-base-200/70 hover:text-primary transition-all duration-200">
										{item.text}
									</a>
								) : (
									<details class="dropdown-button w-full">
										<summary class="hover:bg-base-200/70 hover:text-primary transition-all duration-200">
											{item.text}
										</summary>
										<ul class="dropdown-menu p-2">
											{item.items?.map((subItem) => (
												<li>
													<a href={subItem.to} class="hover:bg-base-200/70 hover:text-primary transition-all duration-200">
														<div>
															<div class="font-medium">{subItem.text}</div>
															{subItem.description && (
																<div class="text-xs opacity-70">{subItem.description}</div>
															)}
														</div>
													</a>
												</li>
											))}
										</ul>
									</details>
								)}
							</li>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</header>

{/* 登录模态框 */}
<dialog id="login-modal" class="modal">
	<div class="modal-box">
		<form method="dialog">
			<button id="close-modal" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">
				<XIcon className="h-5 w-5" />
			</button>
		</form>
		<h3 class="font-bold text-lg mb-4">用户登录</h3>
		<form id="login-form" class="space-y-4">
			<div class="form-control w-full">
				<label class="label">
					<span class="label-text">邮箱</span>
				</label>
				<input type="email" id="email" name="email" required class="input input-bordered w-full" autocomplete="username" />
			</div>
			<div class="form-control w-full">
				<label class="label">
					<span class="label-text">密码</span>
				</label>
				<input type="password" id="password" name="password" required class="input input-bordered w-full" autocomplete="current-password"/>
			</div>
			<div class="flex items-center justify-between">
				<div class="form-control">
