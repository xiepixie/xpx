---
interface Props {
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
  mapping?: string;
  term?: string;
  reactionsEnabled?: boolean;
  emitMetadata?: boolean;
  inputPosition?: 'top' | 'bottom';
  theme?: string;
  lang?: string;
  loading?: 'lazy' | 'eager';
  showTitle?: boolean;
  title?: string;
}

// 从环境变量获取默认值
const defaultRepo = import.meta.env.GISCUS_REPO || 'paxie/xpx_blog';
const defaultRepoId = import.meta.env.GISCUS_REPO_ID || 'R_kgDOLjm_UQ';
const defaultCategory = import.meta.env.GISCUS_CATEGORY || 'Comments';
const defaultCategoryId = import.meta.env.GISCUS_CATEGORY_ID || 'DIC_kwDOLjm_Uc4Cd5vO';

const {
  repo = defaultRepo,
  repoId = defaultRepoId,
  category = defaultCategory,
  categoryId = defaultCategoryId,
  mapping = "pathname",
  term = "",
  reactionsEnabled = true,
  emitMetadata = false,
  inputPosition = "top",
  theme = "preferred_color_scheme",
  lang = "zh-CN",
  loading = "lazy",
  showTitle = false,
  title = "评论"
} = Astro.props;
---

<section class="giscus-comments mt-10 pt-8 border-t border-base-300">
  {showTitle && <h3 class="text-xl font-semibold mb-6">{title}</h3>}
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-mapping={mapping}
    data-term={term}
    data-reactions-enabled={reactionsEnabled ? "1" : "0"}
    data-emit-metadata={emitMetadata ? "1" : "0"}
    data-input-position={inputPosition}
    data-theme={theme}
    data-lang={lang}
    data-loading={loading}
    crossorigin="anonymous"
    async
  ></script>
</section>

<style>
  .giscus-comments {
    width: 100%;
  }
</style>