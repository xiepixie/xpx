---
interface Props {
    headings: {
        depth: number
        slug: string
        text: string
    }[]
}

const { headings } = Astro.props

// 只显示 h2 和 h3 标题
const filteredHeadings = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3
)

// 创建嵌套结构
type TocItem = {
    depth: number
    slug: string
    text: string
    children: TocItem[]
}

const tocItems: TocItem[] = []
let currentH2: TocItem | null = null

// 使用 for...of 替代 forEach
for (const heading of filteredHeadings) {
    if (heading.depth === 2) {
        currentH2 = {
            depth: heading.depth,
            slug: heading.slug,
            text: heading.text,
            children: [],
        }
        tocItems.push(currentH2)
    } else if (heading.depth === 3 && currentH2) {
        currentH2.children.push({
            depth: heading.depth,
            slug: heading.slug,
            text: heading.text,
            children: [],
        })
    }
}
---

{
    filteredHeadings.length > 0 && (
        <>
            {/* 移动端目录切换按钮 */}
            <button id="toc-toggle-button" class="toc-toggle-btn lg:hidden">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="21" y1="10" x2="7" y2="10" />
                    <line x1="21" y1="6" x2="3" y2="6" />
                    <line x1="21" y1="14" x2="3" y2="14" />
                    <line x1="21" y1="18" x2="7" y2="18" />
                </svg>
                <span class="absolute -top-1 -right-1 bg-primary text-primary-content text-xs w-5 h-5 rounded-full flex items-center justify-center">
                    {filteredHeadings.length}
                </span>
            </button>

            <div
                id="toc-container"
                class="toc-container max-h-[calc(100vh-8rem)] overflow-y-auto"
            >
                <div class="card bg-base-100 shadow-sm border border-base-300 p-5 rounded-xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-bold flex items-center text-primary">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 mr-2"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="21" y1="10" x2="7" y2="10" />
                                <line x1="21" y1="6" x2="3" y2="6" />
                                <line x1="21" y1="14" x2="3" y2="14" />
                                <line x1="21" y1="18" x2="7" y2="18" />
                            </svg>
                            目录 ({filteredHeadings.length})
                        </h2>

                        {/* 移动端关闭按钮 */}
                        <button
                            id="toc-close-button"
                            class="btn btn-sm btn-ghost btn-circle lg:hidden"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>

                    <nav class="toc">
                        <ul class="space-y-1.5">
                            {tocItems.map((item) => (
                                <li class="group toc-item" data-slug={item.slug}>
                                    <div class="flex items-center">
                                        <a
                                            href={`#${item.slug}`}
                                            class="flex items-center py-1 px-2 rounded-md transition-all duration-200 text-sm text-base-content/80 hover:text-primary hover:bg-base-200/50 group-hover:pl-3 flex-1"
                                        >
                                            <span class="flex-1">{item.text}</span>
                                        </a>
                                        {item.children.length > 0 && (
                                            <button
                                                type="button"
                                                class="toggle-btn p-1 rounded-md text-base-content/60 hover:text-primary hover:bg-base-200/50 transition-all duration-200 flex items-center justify-center"
                                                data-parent-slug={item.slug}
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-4 w-4 transform transition-transform duration-200"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                >
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                            </button>
                                        )}
                                    </div>
                                    {item.children.length > 0 && (
                                        <ul class="pl-3 mt-1 space-y-1 border-l border-base-300 group-hover:border-primary/30 transition-colors duration-300 toc-submenu" data-parent-slug={item.slug}>
                                            {item.children.map((child) => (
                                                <li>
                                                    <a
                                                        href={`#${child.slug}`}
                                                        class="flex items-center py-0.5 px-2 text-xs hover:text-primary transition-all duration-200 text-base-content/70 hover:bg-base-200/30 rounded hover:pl-3"
                                                        data-slug={child.slug}
                                                    >
                                                        <span class="flex-1">
                                                            {child.text}
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </nav>
                </div>
            </div>
        </>
    )
}

<script>
    // 导入IndexedDB工具函数
    import { saveTocItemState, getTocItemState } from '../lib/tocStorage.js';

    // 高亮当前活动的目录项和移动端目录控制
    document.addEventListener('astro:page-load', async () => {
        // 获取DOM元素
        const tocContainer = document.getElementById('toc-container');
        const tocToggleButton = document.getElementById('toc-toggle-button');
        const tocCloseButton = document.getElementById('toc-close-button');

        // 缓存变量
        let activeName = '';
        let scrollTimeout = null;
        let headingsCache = [];
        let tocLinksCache = [];
        let tocItemsCache = [];
        let toggleButtonsCache = [];

        // 初始化缓存，减少DOM查询
        function initCache() {
            headingsCache = Array.from(document.querySelectorAll('h2[id], h3[id]'));
            tocLinksCache = Array.from(document.querySelectorAll('.toc a'));
            tocItemsCache = Array.from(document.querySelectorAll('.toc-item'));
            toggleButtonsCache = Array.from(document.querySelectorAll('.toggle-btn'));
            return headingsCache.length > 0;
        }

        // 初始化缓存
        initCache();

        // 处理目录链接点击，使标题滚动到页面中间位置
        function handleTocLinkClick() {
            tocLinksCache.forEach((link) => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const href = link.getAttribute('href');

                    if (href && href.startsWith('#')) {
                        const targetId = href.substring(1);
                        const targetElement = document.getElementById(targetId);

                        if (targetElement) {
                            // 计算目标位置，使标题在视口的上部位置
                            const targetPosition =
                                targetElement.getBoundingClientRect().top +
                                window.scrollY;
                            const offset = 80; // 固定偏移量，避免标题被固定导航栏遮挡

                            // 高亮当前点击的链接
                            updateActiveHeading(targetId);

                            // 使用更快的平滑滚动
                            document.documentElement.classList.add('smooth-scroll');

                            window.scrollTo({
                                top: targetPosition - offset,
                                behavior: 'smooth'
                            });

                            // 滚动完成后移除类
                            setTimeout(() => {
                                document.documentElement.classList.remove('smooth-scroll');
                            }, 300);

                            // 更新URL哈希，但不触发默认的滚动行为
                            history.pushState(null, '', href);

                            // 如果在移动端，关闭目录
                            if (window.innerWidth < 1024 && tocContainer) {
                                tocContainer.classList.remove('visible');
                            }
                        }
                    }
                });
            });
        }

        // 处理折叠/展开子目录
        async function handleToggleButtons() {
            for (const btn of toggleButtonsCache) {
                const parentSlug = btn.getAttribute('data-parent-slug');
                if (!parentSlug) continue;

                const tocItem = btn.closest('.toc-item');
                if (!tocItem) continue;

                const submenu = document.querySelector(`.toc-submenu[data-parent-slug="${parentSlug}"]`);
                if (!submenu) continue;

                // 从IndexedDB获取折叠状态
                const isCollapsed = await getTocItemState(parentSlug);

                // 应用折叠状态
                if (isCollapsed) {
                    submenu.classList.add('collapsed');
                    const svgIcon = btn.querySelector('svg');
                    if (svgIcon) {
                        svgIcon.classList.add('rotate');
                    }
                }

                // 添加点击事件
                btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    e.stopPropagation();

                    // 切换子菜单的折叠状态
                    const isCurrentlyCollapsed = submenu.classList.contains('collapsed');
                    const newState = !isCurrentlyCollapsed;

                    // 更新UI
                    if (newState) {
                        submenu.classList.add('collapsed');
                    } else {
                        submenu.classList.remove('collapsed');
                    }

                    // 切换箭头方向
                    const svgIcon = btn.querySelector('svg');
                    if (svgIcon) {
                        if (newState) {
                            svgIcon.classList.add('rotate');
                        } else {
                            svgIcon.classList.remove('rotate');
                        }
                    }

                    // 保存到IndexedDB
                    await saveTocItemState(parentSlug, newState);
                });
            }
        }

        // 移动端目录控制
        function setupMobileControls() {
            if (!tocToggleButton || !tocContainer || !tocCloseButton) return;

            // 显示目录
            tocToggleButton.addEventListener('click', () => {
                tocContainer.classList.add('visible');
                // 添加动画效果
                tocToggleButton.classList.add('animate-bounce');
                setTimeout(() => {
                    tocToggleButton.classList.remove('animate-bounce');
                }, 300);
            });

            // 隐藏目录
            tocCloseButton.addEventListener('click', () => {
                tocContainer.classList.remove('visible');
            });

            // 点击目录外部区域关闭目录
            document.addEventListener('click', (e) => {
                if (
                    tocContainer.classList.contains('visible') &&
                    !tocContainer.contains(e.target) &&
                    e.target !== tocToggleButton
                ) {
                    tocContainer.classList.remove('visible');
                }
            });
        }

        // 更新活动标题的UI
        function updateActiveHeading(id) {
            if (id === activeName) return; // 避免不必要的DOM操作

            activeName = id;

            // 移除所有活动状态
            tocItemsCache.forEach(item => {
                item.classList.remove('active');
            });

            tocLinksCache.forEach(link => {
                link.classList.remove('active');
            });

            // 添加当前链接的活动状态
            const activeLink = document.querySelector(`.toc a[href="#${id}"]`);
            if (!activeLink) return;

            activeLink.classList.add('active');

            // 找到父级 toc-item 并添加活动状态
            const parentItem = activeLink.closest('.toc-item');
            if (!parentItem) return;

            parentItem.classList.add('active');

            // 确保子菜单展开
            const parentSlug = parentItem.getAttribute('data-slug');
            if (parentSlug) {
                const submenu = document.querySelector(`.toc-submenu[data-parent-slug="${parentSlug}"]`);
                if (submenu) {
                    submenu.classList.remove('collapsed');

                    // 更新折叠按钮图标
                    const toggleBtn = parentItem.querySelector('.toggle-btn svg');
                    if (toggleBtn) {
                        toggleBtn.classList.remove('rotate');
                    }

                    // 更新IndexedDB中的状态
                    saveTocItemState(parentSlug, false);
                }
            }

            // 如果在移动端，确保当前活动项在可视区域内
            if (
                window.innerWidth < 1024 &&
                tocContainer &&
                tocContainer.classList.contains('visible')
            ) {
                activeLink.scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest',
                });
            }
        }

        // 加载滚动位置并更新活动标题
        function loadScroll() {
            if (!headingsCache.length) return;

            // 获取当前滚动位置
            const scrollPosition = window.scrollY;
            const viewportHeight = window.innerHeight;

            // 找到当前可见的标题
            let currentHeading = null;
            let minDistance = Infinity;

            // 计算每个标题到视口顶部的距离
            for (const heading of headingsCache) {
                const rect = heading.getBoundingClientRect();
                const distanceToTop = Math.abs(rect.top);

                // 如果标题在视口内或接近视口顶部
                if (rect.top <= 100 && rect.bottom >= -100) {
                    if (distanceToTop < minDistance) {
                        minDistance = distanceToTop;
                        currentHeading = heading;
                    }
                }
            }

            // 如果没有找到当前标题，使用第一个标题
            if (!currentHeading && headingsCache.length > 0) {
                // 如果在页面顶部，使用第一个标题
                if (scrollPosition < 100) {
                    currentHeading = headingsCache[0];
                } else {
                    // 如果在页面底部，使用最后一个标题
                    const documentHeight = document.documentElement.scrollHeight;
                    if (scrollPosition + viewportHeight >= documentHeight - 100) {
                        currentHeading = headingsCache[headingsCache.length - 1];
                    }
                }
            }

            // 如果找到了当前标题，更新活动状态
            if (currentHeading) {
                const id = currentHeading.getAttribute('id');
                if (id) {
                    updateActiveHeading(id);
                }
            }
        }

        // 使用 IntersectionObserver 监听标题元素的可见性变化
        const observer = new IntersectionObserver(
            (entries) => {
                // 找出所有可见的标题
                const visibleEntries = entries.filter(entry => entry.isIntersecting);

                if (visibleEntries.length > 0) {
                    // 如果有多个可见标题，选择最靠近顶部的一个
                    let topEntry = visibleEntries[0];
                    let minDistance = Math.abs(topEntry.boundingClientRect.top);

                    for (const entry of visibleEntries) {
                        const distance = Math.abs(entry.boundingClientRect.top);
                        if (distance < minDistance) {
                            minDistance = distance;
                            topEntry = entry;
                        }
                    }

                    // 更新活动标题
                    const id = topEntry.target.getAttribute('id');
                    if (id) {
                        updateActiveHeading(id);
                    }
                } else {
                    // 如果没有标题进入视口，使用滚动位置计算
                    loadScroll();
                }
            },
            {
                // 调整观察区域，使其更精确地检测当前章节
                rootMargin: '-60px 0px -60% 0px',
                threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
            }
        );

        // 初始化观察者
        function initObserver() {
            // 观察所有标题元素
            for (const heading of headingsCache) {
                observer.observe(heading);
            }
        }

        // 使用节流函数优化滚动事件
        function throttleScroll() {
            if (scrollTimeout) return;

            scrollTimeout = window.setTimeout(() => {
                requestAnimationFrame(loadScroll);
                scrollTimeout = null;
            }, 100); // 100ms 节流间隔
        }

        // 添加动画类
        function addAnimationStyles() {
            if (!document.querySelector('.toc-animations')) {
                const style = document.createElement('style');
                style.className = 'toc-animations';
                style.textContent = `
                    @keyframes bounce {
                        0%, 100% { transform: translateY(0); }
                        50% { transform: translateY(-10px); }
                    }
                    .animate-bounce {
                        animation: bounce 0.3s ease-in-out;
                    }

                    @keyframes pulse {
                        0% { opacity: 0.6; }
                        50% { opacity: 1; }
                        100% { opacity: 0.6; }
                    }
                    .toc-item.active::before {
                        animation: pulse 2s ease-in-out infinite;
                    }
                `;
                document.head.appendChild(style);
            }
        }

        // 初始化所有功能
        async function initialize() {
            // 初始化缓存
            initCache();

            // 设置事件处理程序
            handleTocLinkClick();
            await handleToggleButtons();
            setupMobileControls();

            // 初始化观察者
            initObserver();

            // 添加滚动事件监听器
            window.addEventListener('scroll', throttleScroll, { passive: true });

            // 添加动画样式
            addAnimationStyles();

            // 初始加载时立即计算当前活动标题
            setTimeout(loadScroll, 100);
        }

        // 启动初始化
        initialize();
    });
</script>

<style>
    .toc-container {
        width: 100%;
    }

    .toc a.active {
        color: hsl(var(--p));
        font-weight: 700;
        background-color: hsl(var(--p) / 0.1);
        border-left: 3px solid hsl(var(--p));
        padding-left: 0.75rem !important;
        transform: translateX(2px);
    }

    /* 添加左侧进度指示器 */
    .toc-item.active {
        position: relative;
    }

    .toc-item.active::before {
        content: '';
        position: absolute;
        left: -10px;
        top: 0;
        height: 100%;
        width: 4px;
        background-color: hsl(var(--p));
        border-radius: 4px;
        box-shadow: 0 0 8px hsl(var(--p) / 0.5);
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0% { opacity: 0.7; }
        50% { opacity: 1; }
        100% { opacity: 0.7; }
    }

    /* 添加滚动条样式 */
    .toc-container::-webkit-scrollbar {
        width: 4px;
    }

    .toc-container::-webkit-scrollbar-track {
        background: hsl(var(--b2));
        border-radius: 10px;
    }

    .toc-container::-webkit-scrollbar-thumb {
        background: hsl(var(--p) / 0.3);
        border-radius: 10px;
    }

    .toc-container::-webkit-scrollbar-thumb:hover {
        background: hsl(var(--p) / 0.5);
    }

    /* 响应式设计 - 优化移动端显示 */
    @media (max-width: 1024px) {
        .toc-container {
            position: fixed;
            bottom: 5rem;
            left: 1rem;
            z-index: 40;
            max-width: 85vw;
            max-height: 70vh;
            transform: translateY(150%);
            transition:
                transform 0.3s ease-in-out,
                opacity 0.3s ease;
            box-shadow:
                0 10px 25px -5px rgba(0, 0, 0, 0.1),
                0 8px 10px -6px rgba(0, 0, 0, 0.1);
            opacity: 0;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .toc-container.visible {
            transform: translateY(0);
            opacity: 1;
        }

        /* 添加悬浮按钮 */
        .toc-toggle-btn {
            position: fixed;
            bottom: 1.5rem;
            left: 1rem;
            z-index: 41;
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 50%;
            background-color: hsl(var(--p));
            color: hsl(var(--pc));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow:
                0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            cursor: pointer;
            transition: all 0.3s ease;
            /* 确保按钮在移动端可见 */
            opacity: 1 !important;
            visibility: visible !important;
        }

        .toc-toggle-btn:hover,
        .toc-toggle-btn:active {
            transform: scale(1.05) rotate(5deg);
            box-shadow:
                0 10px 15px -3px rgba(0, 0, 0, 0.1),
                0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        /* 移动端目录容器样式增强 */
        .toc-container .card {
            border-width: 2px;
            max-height: 70vh;
            overflow-y: auto;
            background-color: hsl(var(--b1) / 0.95);
        }

        /* 滚动条样式优化 */
        .toc-container .card::-webkit-scrollbar {
            width: 3px;
        }

        /* 确保移动端目录项可点击 */
        .toc a {
            padding: 0.75rem 0.5rem;
            margin: 0.25rem 0;
        }
    }

    /* 暗色模式调整 */
    :global(.dark) .toc a.active {
        background-color: hsl(var(--p) / 0.2);
    }

    /* 折叠/展开子目录样式 */
    .toc-submenu {
        max-height: 500px; /* 设置一个足够大的值 */
        overflow: hidden;
        transition: max-height 0.2s ease-in-out, opacity 0.2s ease-in-out, margin 0.2s ease-in-out;
        opacity: 1;
        margin-top: 0.25rem;
        margin-bottom: 0.25rem;
    }

    .toc-submenu.collapsed {
        max-height: 0 !important;
        opacity: 0;
        margin-top: 0;
        margin-bottom: 0;
        padding-top: 0;
        padding-bottom: 0;
    }

    .toggle-btn {
        cursor: pointer;
    }

    .toggle-btn svg.rotate {
        transform: rotate(180deg);
    }

    /* 增强按钮可见性 */
    .toggle-btn:hover {
        background-color: hsl(var(--p) / 0.2);
        color: hsl(var(--p));
    }

    /* 滚动平滑效果 - 加快速度 */
    html {
        scroll-behavior: smooth;
    }

    /* 自定义滚动速度 */
    .smooth-scroll {
        scroll-behavior: smooth;
        transition-duration: 200ms !important; /* 加快滚动速度 */
    }

    /* 活动项样式增强 */
    .toc-item.active > div > a {
        color: hsl(var(--p));
        font-weight: 700;
    }

    .toc-item.active > div > .toggle-btn {
        color: hsl(var(--p));
    }
</style>
