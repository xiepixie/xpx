---
interface Props {
    headings: {
        depth: number
        slug: string
        text: string
    }[]
}

const { headings } = Astro.props

// 只显示 h2 和 h3 标题
const filteredHeadings = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3
)

// 创建嵌套结构
type TocItem = {
    depth: number
    slug: string
    text: string
    children: TocItem[]
}

const tocItems: TocItem[] = []
let currentH2: TocItem | null = null

// 使用 for...of 替代 forEach
for (const heading of filteredHeadings) {
    if (heading.depth === 2) {
        currentH2 = {
            depth: heading.depth,
            slug: heading.slug,
            text: heading.text,
            children: [],
        }
        tocItems.push(currentH2)
    } else if (heading.depth === 3 && currentH2) {
        currentH2.children.push({
            depth: heading.depth,
            slug: heading.slug,
            text: heading.text,
            children: [],
        })
    }
}
---

{
    filteredHeadings.length > 0 && (
        <>
            {/* 移动端目录切换按钮 */}
            <button id="toc-toggle-button" class="toc-toggle-btn lg:hidden">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="21" y1="10" x2="7" y2="10" />
                    <line x1="21" y1="6" x2="3" y2="6" />
                    <line x1="21" y1="14" x2="3" y2="14" />
                    <line x1="21" y1="18" x2="7" y2="18" />
                </svg>
                <span class="absolute -top-1 -right-1 bg-primary text-primary-content text-xs w-5 h-5 rounded-full flex items-center justify-center">
                    {filteredHeadings.length}
                </span>
            </button>

            <div
                id="toc-container"
                class="toc-container max-h-[calc(100vh-8rem)] overflow-y-auto"
            >
                <div class="card bg-base-100 shadow-sm border border-base-300 p-5 rounded-xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-bold flex items-center text-primary">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 mr-2"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="21" y1="10" x2="7" y2="10" />
                                <line x1="21" y1="6" x2="3" y2="6" />
                                <line x1="21" y1="14" x2="3" y2="14" />
                                <line x1="21" y1="18" x2="7" y2="18" />
                            </svg>
                            目录 ({filteredHeadings.length})
                        </h2>

                        {/* 移动端关闭按钮 */}
                        <button
                            id="toc-close-button"
                            class="btn btn-sm btn-ghost btn-circle lg:hidden"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>

                    <nav class="toc">
                        <ul class="space-y-1.5">
                            {tocItems.map((item) => (
                                <li class="group">
                                    <a
                                        href={`#${item.slug}`}
                                        class="flex items-center py-1 px-2 rounded-md transition-all duration-200 text-sm text-base-content/80 hover:text-primary hover:bg-base-200/50 group-hover:pl-3"
                                    >
                                        <span class="flex-1">{item.text}</span>
                                    </a>
                                    {item.children.length > 0 && (
                                        <ul class="pl-3 mt-1 space-y-1 border-l border-base-300 group-hover:border-primary/30 transition-colors duration-300">
                                            {item.children.map((child) => (
                                                <li>
                                                    <a
                                                        href={`#${child.slug}`}
                                                        class="flex items-center py-0.5 px-2 text-xs hover:text-primary transition-all duration-200 text-base-content/70 hover:bg-base-200/30 rounded hover:pl-3"
                                                    >
                                                        <span class="flex-1">
                                                            {child.text}
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </nav>
                </div>
            </div>
        </>
    )
}

<script>
    // 高亮当前活动的目录项和移动端目录控制
    document.addEventListener('astro:page-load', () => {
        // 获取DOM元素
        const tocContainer = document.getElementById('toc-container')
        const tocToggleButton = document.getElementById('toc-toggle-button')
        const tocCloseButton = document.getElementById('toc-close-button')

        // 处理目录链接点击，使标题滚动到页面中间位置
        const handleTocLinkClick = () => {
            const tocLinks = document.querySelectorAll('.toc a')

            tocLinks.forEach((link) => {
                link.addEventListener('click', (e) => {
                    e.preventDefault()
                    const href = link.getAttribute('href')

                    if (href && href.startsWith('#')) {
                        const targetId = href.substring(1)
                        const targetElement = document.getElementById(targetId)

                        if (targetElement) {
                            // 计算目标位置，使标题在视口的中间位置
                            const targetPosition =
                                targetElement.getBoundingClientRect().top +
                                window.scrollY
                            const offset = window.innerHeight / 3 // 将标题定位在视口的上三分之一处

                            // 平滑滚动到目标位置
                            window.scrollTo({
                                top: targetPosition - offset,
                                behavior: 'smooth',
                            })

                            // 更新URL哈希，但不触发默认的滚动行为
                            history.pushState(null, '', href)

                            // 如果在移动端，关闭目录
                            if (window.innerWidth < 1024 && tocContainer) {
                                tocContainer.classList.remove('visible')
                            }
                        }
                    }
                })
            })
        }

        // 初始化目录链接点击处理
        handleTocLinkClick()

        // 移动端目录控制
        if (tocToggleButton && tocContainer && tocCloseButton) {
            // 显示目录
            tocToggleButton.addEventListener('click', () => {
                tocContainer.classList.add('visible')
                // 添加动画效果
                tocToggleButton.classList.add('animate-bounce')
                setTimeout(() => {
                    tocToggleButton.classList.remove('animate-bounce')
                }, 500)
            })

            // 隐藏目录
            tocCloseButton.addEventListener('click', () => {
                tocContainer.classList.remove('visible')
            })

            // 点击目录外部区域关闭目录
            document.addEventListener('click', (e) => {
                if (
                    tocContainer.classList.contains('visible') &&
                    !tocContainer.contains(e.target as Node) &&
                    e.target !== tocToggleButton
                ) {
                    tocContainer.classList.remove('visible')
                }
            })
        }

        // 声明活动标题名称变量
        let activeName: string = ''
        let scrollTimeout: number | null = null
        let headingsCache: Element[] = []
        let tocLinksCache: Element[] = []

        // 初始化缓存，减少DOM查询
        function initCache() {
            headingsCache = Array.from(
                document.querySelectorAll('h2[id], h3[id]')
            )
            tocLinksCache = Array.from(document.querySelectorAll('.toc a'))
            return headingsCache.length > 0
        }

        // 更新活动标题的UI
        function updateActiveHeading(id: string) {
            if (id === activeName) return // 避免不必要的DOM操作

            activeName = id

            // 使用缓存的链接元素
            for (const link of tocLinksCache) {
                link.classList.remove('active')
            }

            // 添加当前链接的活动状态
            const activeLink = document.querySelector(`.toc a[href="#${id}"]`)
            if (activeLink) {
                activeLink.classList.add('active')

                // 如果在移动端，确保当前活动项在可视区域内
                if (
                    window.innerWidth < 1024 &&
                    tocContainer &&
                    tocContainer.classList.contains('visible')
                ) {
                    activeLink.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest',
                    })
                }
            }
        }

        // 加载滚动位置并更新活动标题 - 节流版本
        function loadScroll() {
            if (!headingsCache.length && !initCache()) return

            // 获取当前滚动位置
            const scrollPosition = window.scrollY

            // 找到当前可见的标题
            let currentHeading: Element | null = null

            // 使用缓存的标题元素
            for (const heading of headingsCache) {
                // 获取标题的位置，考虑一个偏移量以提供更好的用户体验
                const headingTop =
                    heading.getBoundingClientRect().top + window.scrollY - 120

                if (scrollPosition >= headingTop) {
                    currentHeading = heading
                } else {
                    // 如果已经超过了当前滚动位置，不需要继续检查
                    break
                }
            }

            // 如果没有找到当前标题（例如，在页面顶部），使用第一个标题
            if (!currentHeading && headingsCache.length > 0) {
                currentHeading = headingsCache[0]
            }

            // 如果找到了当前标题，更新活动状态
            if (currentHeading) {
                const id = currentHeading.getAttribute('id')
                if (id) {
                    updateActiveHeading(id)
                }
            }
        }

        // 使用 IntersectionObserver 监听标题元素的可见性变化
        const observer = new IntersectionObserver(
            (entries) => {
                // 当有标题进入或离开视口时，重新计算当前活动标题
                // 检查是否有标题进入视口
                const visibleEntry = entries.find(
                    (entry) => entry.isIntersecting
                )
                if (visibleEntry) {
                    // 如果有标题进入视口，直接更新活动标题
                    const id = visibleEntry.target.getAttribute('id')
                    if (id) {
                        updateActiveHeading(id)
                    }
                } else {
                    // 如果没有标题进入视口，使用滚动位置计算
                    loadScroll()
                }
            },
            {
                rootMargin: '-100px 0px -66% 0px',
                threshold: [0, 0.25, 0.5, 0.75, 1],
            }
        )

        // 初始化观察者
        function initObserver() {
            if (!headingsCache.length && !initCache()) return

            // 观察所有标题元素
            for (const heading of headingsCache) {
                observer.observe(heading)
            }
        }

        // 使用节流函数优化滚动事件
        function throttleScroll() {
            if (scrollTimeout) return

            scrollTimeout = window.setTimeout(() => {
                requestAnimationFrame(loadScroll)
                scrollTimeout = null
            }, 100) // 100ms 节流间隔
        }

        // 初始化
        initCache()
        initObserver()

        // 添加滚动事件监听器
        window.addEventListener('scroll', throttleScroll, { passive: true })

        // 添加动画类
        if (!document.querySelector('.animate-bounce')) {
            const style = document.createElement('style')
            style.textContent = `
        @keyframes bounce {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-10px); }
        }
        .animate-bounce {
          animation: bounce 0.5s ease-in-out;
        }
      `
            document.head.appendChild(style)
        }
    })
</script>

<style>
    .toc-container {
        width: 100%;
    }

    .toc a.active {
        color: hsl(var(--p));
        font-weight: 700;
        background-color: hsl(var(--p) / 0.1);
        border-left: 2px solid hsl(var(--p));
        padding-left: 0.75rem !important;
        transform: translateX(2px);
    }

    /* 添加滚动条样式 */
    .toc-container::-webkit-scrollbar {
        width: 4px;
    }

    .toc-container::-webkit-scrollbar-track {
        background: hsl(var(--b2));
        border-radius: 10px;
    }

    .toc-container::-webkit-scrollbar-thumb {
        background: hsl(var(--p) / 0.3);
        border-radius: 10px;
    }

    .toc-container::-webkit-scrollbar-thumb:hover {
        background: hsl(var(--p) / 0.5);
    }

    /* 响应式设计 - 优化移动端显示 */
    @media (max-width: 1024px) {
        .toc-container {
            position: fixed;
            bottom: 5rem;
            left: 1rem;
            z-index: 40;
            max-width: 85vw;
            max-height: 70vh;
            transform: translateY(150%);
            transition:
                transform 0.3s ease-in-out,
                opacity 0.3s ease;
            box-shadow:
                0 10px 25px -5px rgba(0, 0, 0, 0.1),
                0 8px 10px -6px rgba(0, 0, 0, 0.1);
            opacity: 0;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .toc-container.visible {
            transform: translateY(0);
            opacity: 1;
        }

        /* 添加悬浮按钮 */
        .toc-toggle-btn {
            position: fixed;
            bottom: 1.5rem;
            left: 1rem;
            z-index: 41;
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 50%;
            background-color: hsl(var(--p));
            color: hsl(var(--pc));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow:
                0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            cursor: pointer;
            transition: all 0.3s ease;
            /* 确保按钮在移动端可见 */
            opacity: 1 !important;
            visibility: visible !important;
        }

        .toc-toggle-btn:hover,
        .toc-toggle-btn:active {
            transform: scale(1.05) rotate(5deg);
            box-shadow:
                0 10px 15px -3px rgba(0, 0, 0, 0.1),
                0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        /* 移动端目录容器样式增强 */
        .toc-container .card {
            border-width: 2px;
            max-height: 70vh;
            overflow-y: auto;
            background-color: hsl(var(--b1) / 0.95);
        }

        /* 滚动条样式优化 */
        .toc-container .card::-webkit-scrollbar {
            width: 3px;
        }

        /* 确保移动端目录项可点击 */
        .toc a {
            padding: 0.75rem 0.5rem;
            margin: 0.25rem 0;
        }
    }

    /* 暗色模式调整 */
    :global(.dark) .toc a.active {
        background-color: hsl(var(--p) / 0.2);
    }
</style>
