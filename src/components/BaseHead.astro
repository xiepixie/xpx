---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { getPath } from '../lib/path';

interface Props {
	title: string;
	description: string;
	image?: string;
	canonicalURL?: string;
	pageType?: string;
}

const { title, description, image = '/blog-placeholder-1.jpg', canonicalURL = Astro.url, pageType = 'website' } = Astro.props;
const processedImage = image.startsWith('http') ? image : getPath(image.startsWith('/') ? image.slice(1) : image);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={getPath('favicon.svg')} />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href={getPath('fonts/atkinson-regular.woff')} as="font" type="font/woff" crossorigin />
<link rel="preload" href={getPath('fonts/atkinson-bold.woff')} as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={processedImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={processedImage} />

<!-- DaisyUI 配置 -->
<script>
	// Theme 处理已移动到 Header 组件中，为了更早加载
</script>
