---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import "../styles/global.css";

const pageTitle = "关于我们";
const pageDescription = "了解我们的团队和使命";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<main class="container mx-auto px-4 py-8">
		<div class="prose prose-lg mx-auto">
			<h1 class="text-3xl sm:text-4xl font-bold mb-8">关于我们</h1>
			
			<div class="space-y-6">
				<section id="mission">
					<h2 class="text-2xl font-semibold">我们的使命</h2>
					<p>
						我们致力于创建高质量、易于理解的技术内容，帮助开发者和设计师提升技能，跟上行业最新发展。我们相信知识共享和开源精神，希望通过我们的平台为技术社区做出贡献。
					</p>
				</section>
				
				<section id="team">
					<h2 class="text-2xl font-semibold">我们的团队</h2>
					<p>
						我们的团队由经验丰富的开发者、设计师和内容创作者组成，他们在各自领域都有深厚的专业知识和实践经验。团队成员来自不同的背景，带来多元化的视角和创新思维。
					</p>
					
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
						<div class="card bg-base-100 shadow-xl">
							<figure class="px-6 pt-6">
								<img src="https://daisyui.com/images/stock/photo-1534528741775-53994a69daeb.jpg" alt="团队成员" class="rounded-xl h-48 w-full object-cover" />
							</figure>
							<div class="card-body">
								<h3 class="card-title">张小明</h3>
								<p class="text-sm text-base-content/70">创始人 & 首席技术官</p>
								<p>10年全栈开发经验，热爱分享技术知识和最佳实践。</p>
							</div>
						</div>
						
						<div class="card bg-base-100 shadow-xl">
							<figure class="px-6 pt-6">
								<img src="https://daisyui.com/images/stock/photo-1534528741775-53994a69daeb.jpg" alt="团队成员" class="rounded-xl h-48 w-full object-cover" />
							</figure>
							<div class="card-body">
								<h3 class="card-title">李晓华</h3>
								<p class="text-sm text-base-content/70">内容总监</p>
								<p>专注于创建易于理解的技术教程和深度分析文章。</p>
							</div>
						</div>
						
						<div class="card bg-base-100 shadow-xl">
							<figure class="px-6 pt-6">
								<img src="https://daisyui.com/images/stock/photo-1534528741775-53994a69daeb.jpg" alt="团队成员" class="rounded-xl h-48 w-full object-cover" />
							</figure>
							<div class="card-body">
								<h3 class="card-title">王大力</h3>
								<p class="text-sm text-base-content/70">UI/UX 设计师</p>
								<p>专注于创建美观且用户友好的数字体验。</p>
							</div>
						</div>
					</div>
				</section>
				
				<section id="contact">
					<h2 class="text-2xl font-semibold">联系我们</h2>
					<p>
						我们欢迎您的反馈和建议。如果您有任何问题或合作意向，请随时联系我们。
					</p>
					
					<div class="card bg-base-100 shadow-xl mt-6">
						<div class="card-body">
							<form class="space-y-4">
								<div class="form-control">
									<label class="label">
										<span class="label-text">您的姓名</span>
									</label>
									<input type="text" placeholder="请输入您的姓名" class="input input-bordered" />
								</div>
								
								<div class="form-control">
									<label class="label">
										<span class="label-text">电子邮箱</span>
									</label>
									<input type="email" placeholder="请输入您的电子邮箱" class="input input-bordered" />
								</div>
								
								<div class="form-control">
									<label class="label">
										<span class="label-text">留言内容</span>
									</label>
									<textarea class="textarea textarea-bordered h-24" placeholder="请输入您的留言内容"></textarea>
								</div>
								
								<div class="form-control mt-6">
									<button class="btn btn-primary">发送留言</button>
								</div>
							</form>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>
	
	<FloatingMenu 
		modules={[
			{ id: 'mission', title: '使命', icon: 'BookOpen' },
			{ id: 'team', title: '团队', icon: 'BarChart3' },
			{ id: 'contact', title: '联系', icon: 'Calendar' },
		]}
	/>
</BaseLayout>
