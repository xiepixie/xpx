---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import { Button } from '../components/react/Button';
import { Mail, Phone, MessageSquare, MapPin, Send } from '../components/react/Icons';

const pageTitle = "联系我们";
const pageDescription = "如果您有任何问题或建议，欢迎通过以下方式与我们联系。";
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <main class="container mx-auto px-4 py-12">
        <div class="max-w-5xl mx-auto">
            <h1 class="text-3xl sm:text-4xl font-bold mb-6">{pageTitle}</h1>
            <p class="text-base-content/70 text-lg mb-12 max-w-3xl">{pageDescription}</p>
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
                <div class="card bg-base-100 shadow-xl border border-base-300 text-center p-6">
                    <div class="mx-auto rounded-full bg-primary/10 p-4 mb-4">
                        <Mail className="h-6 w-6 text-primary" />
                    </div>
                    <h3 class="font-bold text-lg mb-2">电子邮件</h3>
                    <p class="text-base-content/70">随时向我们发送电子邮件，我们会尽快回复您</p>
                    <a href="mailto:contact@example.com" class="link link-primary mt-4">contact@example.com</a>
                </div>
                
                <div class="card bg-base-100 shadow-xl border border-base-300 text-center p-6">
                    <div class="mx-auto rounded-full bg-primary/10 p-4 mb-4">
                        <Phone className="h-6 w-6 text-primary" />
                    </div>
                    <h3 class="font-bold text-lg mb-2">电话</h3>
                    <p class="text-base-content/70">工作日 9:00-18:00 为您提供电话支持</p>
                    <a href="tel:+86123456789" class="link link-primary mt-4">+86 123 4567 890</a>
                </div>
                
                <div class="card bg-base-100 shadow-xl border border-base-300 text-center p-6">
                    <div class="mx-auto rounded-full bg-primary/10 p-4 mb-4">
                        <MapPin className="h-6 w-6 text-primary" />
                    </div>
                    <h3 class="font-bold text-lg mb-2">地址</h3>
                    <p class="text-base-content/70">中国上海市浦东新区张江高科技园区</p>
                    <a href="https://maps.google.com" target="_blank" class="link link-primary mt-4">查看地图</a>
                </div>
            </div>
            
            <!-- 联系表单 -->
            <div class="card bg-base-100 shadow-xl border border-base-300 p-6 lg:p-8" id="contact-form">
                <h2 class="text-2xl font-bold mb-6">发送消息</h2>
                <form class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text">姓名</span>
                            </label>
                            <input type="text" class="input input-bordered w-full" placeholder="您的姓名" required />
                        </div>
                        
                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text">电子邮件</span>
                            </label>
                            <input type="email" class="input input-bordered w-full" placeholder="您的电子邮件" required />
                        </div>
                    </div>
                    
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text">主题</span>
                        </label>
                        <input type="text" class="input input-bordered w-full" placeholder="消息主题" required />
                    </div>
                    
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text">消息</span>
                        </label>
                        <textarea class="textarea textarea-bordered h-32" placeholder="请输入您的消息..." required></textarea>
                    </div>
                    
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-2">
                            <input type="checkbox" class="checkbox checkbox-primary" required />
                            <span class="label-text">我同意隐私政策和服务条款</span>
                        </label>
                    </div>
                    
                    <div class="text-right">
                        <Button client:load variant="primary" className="px-6" type="submit">
                            <Send className="mr-2 h-4 w-4" />
                            发送消息
                        </Button>
                    </div>
                </form>
            </div>
            
            <!-- FAQ 部分 -->
            <div class="mt-16" id="faq">
                <h2 class="text-2xl font-bold mb-6">常见问题</h2>
                
                <div class="space-y-4">
                    <div class="collapse collapse-arrow bg-base-100 border border-base-300 rounded-lg">
                        <input type="radio" name="my-accordion-2" checked="checked" /> 
                        <div class="collapse-title text-xl font-medium">
                            如何订阅您的博客更新？
                        </div>
                        <div class="collapse-content"> 
                            <p>您可以通过我们网站上的RSS订阅功能或在首页底部输入您的电子邮件地址来订阅我们的博客更新。每当有新文章发布时，您都会收到通知。</p>
                        </div>
                    </div>
                    
                    <div class="collapse collapse-arrow bg-base-100 border border-base-300 rounded-lg">
                        <input type="radio" name="my-accordion-2" /> 
                        <div class="collapse-title text-xl font-medium">
                            我可以投稿到您的博客吗？
                        </div>
                        <div class="collapse-content"> 
                            <p>当然可以！我们欢迎高质量的客座投稿。请通过上面的联系表单发送您的提案，包括您的主题和简短的大纲。我们会在收到后尽快回复您。</p>
                        </div>
                    </div>
                    
                    <div class="collapse collapse-arrow bg-base-100 border border-base-300 rounded-lg">
                        <input type="radio" name="my-accordion-2" /> 
                        <div class="collapse-title text-xl font-medium">
                            您提供内容定制服务吗？
                        </div>
                        <div class="collapse-content"> 
                            <p>是的，我们提供内容定制服务。如果您需要针对特定主题的专业内容，请联系我们讨论您的需求和预算。我们的团队将为您提供量身定制的解决方案。</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <FloatingMenu 
        modules={[
            { id: 'contact-form', title: '联系表单', icon: 'MessageSquare' },
            { id: 'faq', title: '常见问题', icon: 'BookOpen' },
        ]}
    />
    
    <script>
        // 简单的表单提交处理
        document.addEventListener('astro:page-load', () => {
            const contactForm = document.querySelector('form');
            
            contactForm?.addEventListener('submit', (e) => {
                e.preventDefault();
                
                // 模拟表单提交
                const submitButton = contactForm.querySelector('button');
                if (submitButton) {
                    submitButton.setAttribute('disabled', 'true');
                    submitButton.innerHTML = '<span class="loading loading-spinner loading-xs mr-2"></span> 发送中...';
                }
                
                // 模拟请求延迟
                setTimeout(() => {
                    // 显示成功消息
                    const formElement = contactForm.parentElement;
                    if (formElement) {
                        formElement.innerHTML = `
                            <div class="text-center py-12">
                                <div class="mx-auto rounded-full bg-success/20 p-4 mb-4 inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <h2 class="text-2xl font-bold mb-2">消息已发送！</h2>
                                <p class="text-base-content/70 mb-6">感谢您联系我们。我们将尽快回复您的消息。</p>
                                <a href="/" class="btn btn-primary">返回首页</a>
                            </div>
                        `;
                    }
                }, 2000);
            });
        });
    </script>
</BaseLayout> 