---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import '../../../styles/global.css';
import { getPath } from '../../../lib/path';

export async function getStaticPaths() {
    // 获取所有博客文章
    const allPosts = await getCollection('blog');

    // 提取所有唯一标签并创建路径
    const uniqueTags = [...new Set(
        allPosts.flatMap(post => post.data.tags || [])
    )];

    return uniqueTags.map(tag => ({
        params: { tag: tag.toLowerCase() },
        props: { tag }
    }));
}

// 获取页面参数
const { tag } = Astro.props;

// 获取包含该标签的所有博客文章
const allPosts = await getCollection('blog');
const taggedPosts = allPosts.filter(
    post => post.data.tags?.map(t => t.toLowerCase()).includes(tag.toLowerCase())
);

// 按发布日期排序
taggedPosts.sort((a, b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf());

const pageTitle = `#${tag} - 相关文章`;
const pageDescription = `查看与 ${tag} 相关的所有博客文章`;

// 提取所有不同的标签，用于显示标签云
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <main class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
            <header class="mb-12 text-center">
                <h1 class="text-3xl sm:text-4xl font-bold mb-4">#{tag}</h1>
                <p class="text-base-content/70">{pageDescription}</p>

                <div class="mt-8 flex flex-wrap gap-2 justify-center">
                    {allTags.map(tagItem => (
                        <a
                            href={getPath(`blog/tag/${tagItem.toLowerCase()}`)}
                            class={`px-4 py-2 rounded-full text-sm transition-colors ${
                                tagItem.toLowerCase() === tag.toLowerCase()
                                    ? 'bg-primary text-primary-content'
                                    : 'bg-base-200 hover:bg-base-300'
                            }`}
                        >
                            #{tagItem}
                        </a>
                    ))}
                </div>
            </header>

            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2" id="blog-list">
                {taggedPosts.length > 0 ? (
                    taggedPosts.map((post) => (
                        <div class="card bg-base-100 shadow-xl overflow-hidden">
                            <figure class="h-48 overflow-hidden">
                                {post.data.seo_image && (
                                    <img
                                        src={getPath(post.data.seo_image)}
                                        alt={post.data.title}
                                        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                                    />
                                )}
                            </figure>
                            <div class="card-body">
                                <div class="flex items-center gap-2 text-sm text-base-content/70 mb-2">
                                    <FormattedDate date={post.data.publish_date} />
                                    {post.data.tags && post.data.tags.length > 0 && (
                                        <>
                                            <span>•</span>
                                            <div class="flex flex-wrap gap-1">
                                                {post.data.tags.map(tagItem => (
                                                    <a href={getPath(`blog/tag/${tagItem.toLowerCase()}`)} class="badge badge-primary">
                                                        {tagItem}
                                                    </a>
                                                ))}
                                            </div>
                                        </>
                                    )}
                                </div>
                                <h2 class="card-title text-xl font-bold">
                                    <a href={getPath(`blog/${post.id}/`)} class="hover:text-primary transition-colors">
                                        {post.data.title}
                                    </a>
                                </h2>
                                <p class="mt-2 line-clamp-3">{post.data.description}</p>
                                <div class="card-actions justify-end mt-4">
                                    <a href={getPath(`blog/${post.id}/`)} class="btn btn-sm btn-primary">
                                        阅读全文 →
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                ) : (
                    <div class="col-span-2 text-center py-12">
                        <div class="text-4xl mb-4">😢</div>
                        <h3 class="text-xl font-bold mb-2">暂无相关文章</h3>
                        <p class="text-base-content/70 mb-6">我们找不到与 "{tag}" 相关的文章</p>
                        <a href={getPath("blog")} class="btn btn-primary">查看所有文章</a>
                    </div>
                )}
            </div>

            {taggedPosts.length > 0 && (
                <div class="mt-12 text-center">
                    <a href={getPath("blog")} class="btn btn-outline">
                        查看所有文章
                    </a>
                </div>
            )}
        </div>
    </main>
</BaseLayout>