---
// 导入组件和常量
import BaseLayout from '../../layouts/BaseLayout.astro';  // 使用BaseLayout
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';  // 网站标题和描述
import { getCollection } from 'astro:content';          // Astro 内容集合API
import FormattedDate from '../../components/FormattedDate.astro';  // 日期格式化组件
import FloatingMenu from '../../components/FloatingMenu.astro';   // 浮动菜单组件
import { getPath } from '../../lib/path';             // 导入路径处理函数

// 获取所有博客文章并按发布日期排序
const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf(),
);

// 分页实现
const FIRST_PAGE_POSTS = 7;  // 首页显示7篇文章
const OTHER_PAGES_POSTS = 9;  // 其他页面每页显示9篇文章（3行3列）
const currentPage = Number(Astro.url.searchParams.get('page') || '1');  // 当前页码

// 计算分页逻辑
const totalPosts = posts.length;
// 计算总页数：首页7篇，其余页面每页9篇
const totalPages = Math.ceil((totalPosts - FIRST_PAGE_POSTS) / OTHER_PAGES_POSTS) + 1;

// 获取当前页的文章
let startIndex = 0;
let endIndex = 0;

if (currentPage === 1) {
    // 首页：获取前7篇文章
    startIndex = 0;
    endIndex = FIRST_PAGE_POSTS;
} else {
    // 其他页：计算正确的起始和结束索引
    startIndex = FIRST_PAGE_POSTS + (currentPage - 2) * OTHER_PAGES_POSTS;
    endIndex = startIndex + OTHER_PAGES_POSTS;
}

// 确保不超出文章总数
endIndex = Math.min(endIndex, totalPosts);

// 获取当前页的文章
const paginatedPosts = posts.slice(startIndex, endIndex);

// 判断是否为首页
const isFirstPage = currentPage === 1;

// 页面标题
const pageTitle = `博客 | ${SITE_TITLE}`;
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION}>
    <script>
        // 简单的分页处理脚本
        document.addEventListener('astro:page-load', () => {
            // 获取所有分页链接
            const paginationLinks = document.querySelectorAll('.join a[href*="blog?page="]');

            // 为分页链接添加点击事件
            paginationLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    // 如果链接被禁用，不执行任何操作
                    if (link.classList.contains('btn-disabled')) {
                        e.preventDefault();
                        return;
                    }

                    // 获取链接的href属性
                    const href = link.getAttribute('href');
                    if (!href || href === '#') return;

                    // 阻止默认行为
                    e.preventDefault();

                    // 添加时间戳参数，确保浏览器不使用缓存
                    const url = new URL(href);
                    url.searchParams.set('_', Date.now().toString());

                    // 使用location.replace进行导航，确保页面完全重新加载
                    window.location.replace(url.toString());
                });
            });
        });
    </script>
    <main class="container mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
        <h1 class="text-4xl md:text-5xl font-bold text-center mb-8 pb-4 text-primary border-b border-base-300">Blog</h1>

        <section class="mb-16">
            <ul class={`grid gap-6 md:gap-8 ${isFirstPage
                ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
                : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'}`}>
                {
                    paginatedPosts.map((post, index) => (
                        <li class={`card bg-base-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2 overflow-hidden ${
                            isFirstPage && index === 0 ? 'md:col-span-2 lg:col-span-3' : ''
                        }`}>
                            <a href={getPath(`blog/${post.id}/`)} class="flex flex-col h-full">
                                <figure class={`${isFirstPage && index === 0 ? 'h-80 md:h-96' : 'h-48 md:h-56'}`}>
                                    <img
                                        src={getPath(post.data.seo_image || 'blog-placeholder-5.jpg')}
                                        alt={post.data.title}
                                        class="w-full h-full object-cover"
                                    />
                                </figure>
                                <div class={`card-body flex-1 ${isFirstPage && index === 0 ? 'md:text-center' : ''}`}>
                                    <h2 class={`card-title ${isFirstPage && index === 0 ? 'text-2xl md:text-3xl justify-center' : 'text-xl'}`}>
                                        {post.data.title}
                                    </h2>
                                    <p class="text-sm text-base-content/70">
                                        <FormattedDate date={post.data.publish_date} />
                                        {post.data.update_date && post.data.update_date > post.data.publish_date && (
                                            <span class="ml-2 text-primary-focus"> · Updated: <FormattedDate date={post.data.update_date} /></span>
                                        )}
                                    </p>
                                    <p class="mt-3 line-clamp-3 text-base-content/80">
                                        {post.data.description || '暂无描述'}
                                    </p>
                                    {isFirstPage && index === 0 && (
                                        <div class="card-actions justify-center mt-4">
                                            <button class="btn btn-primary btn-sm">阅读全文</button>
                                        </div>
                                    )}
                                </div>
                            </a>
                        </li>
                    ))
                }
            </ul>

            {totalPages > 1 && (
                <div class="flex justify-center mt-12 join">
                    {/* 上一页按钮 */}
                    <a
                        href={currentPage > 1 ? `${Astro.url.origin}${getPath(`blog?page=${currentPage - 1}`)}` : '#'}
                        class={`join-item btn ${currentPage <= 1 ? 'btn-disabled' : 'btn-outline'}`}
                        aria-label="Previous page"
                        aria-disabled={currentPage <= 1}
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    </a>

                    {/* 页码按钮 */}
                    {Array.from({ length: totalPages }, (_, i) => (
                        <a
                            href={`${Astro.url.origin}${getPath(`blog?page=${i + 1}`)}`}
                            class={`join-item btn ${currentPage === i + 1 ? 'btn-active' : 'btn-outline'}`}
                            aria-label={`Page ${i + 1}`}
                            aria-current={currentPage === i + 1 ? 'page' : undefined}
                        >
                            {i + 1}
                        </a>
                    ))}

                    {/* 下一页按钮 */}
                    <a
                        href={currentPage < totalPages ? `${Astro.url.origin}${getPath(`blog?page=${currentPage + 1}`)}` : '#'}
                        class={`join-item btn ${currentPage >= totalPages ? 'btn-disabled' : 'btn-outline'}`}
                        aria-label="Next page"
                        aria-disabled={currentPage >= totalPages}
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                </div>
            )}


        </section>
    </main>

    <FloatingMenu
        showModuleNav={true}
    />
</BaseLayout>